# ============================================================
# КЛАВИАТУРЫ
# ============================================================

def main_menu_keyboard():
    builder = InlineKeyboardBuilder()
    builder.button(text="📅 Забронировать аудиторию", callback_data="book_start")
    builder.adjust(1)
    return builder.as_markup()


def date_keyboard():
    builder = InlineKeyboardBuilder()
    today = datetime.now(TIMEZONE).date()
    for i in range(DAYS_AHEAD):
        d = today + timedelta(days=i)
        weekday = WEEKDAYS_RU[d.weekday()]
        text = f"{d.strftime('%d.%m')} {weekday}"
        builder.button(text=text, callback_data=f"date:{d.isoformat()}")
    builder.adjust(3)
    return builder.as_markup()


def time_keyboard(date_str: str):
    busy_hours = get_busy_hours(date_str)
    builder = InlineKeyboardBuilder()
    has_free = False
    for hour in range(WORK_START_HOUR, WORK_END_HOUR):
        if hour in busy_hours:
            continue
        has_free = True
        start, end = slot_bounds(hour)
        builder.button(text=f"{start}–{end}", callback_data=f"time:{hour:02d}")
    if not has_free:
        return None
    builder.adjust(3)
    return builder.as_markup()


def people_keyboard():
    builder = InlineKeyboardBuilder()
    for n in range(1, MAX_PEOPLE + 1):
        builder.button(text=str(n), callback_data=f"people:{n}")
    builder.adjust(6)
    return builder.as_markup()


def delete_confirm_keyboard():
    builder = InlineKeyboardBuilder()
    builder.button(text="✅ Да, удалить всё", callback_data="delete_confirm")
    builder.button(text="❌ Отмена", callback_data="delete_cancel")
    builder.adjust(1)
    return builder.as_markup()


