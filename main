    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
)

logger = logging.getLogger("garaninci_bot")


# ============================================================
# ТОКЕН
# ============================================================

BOT_TOKEN = os.getenv("BOT_TOKEN") or os.getenv("TOKEN")

if not BOT_TOKEN:
    raise RuntimeError(
        "Не найден токен бота. "
        "Добавьте переменную BOT_TOKEN в BotHost."
    )


# ============================================================
# АДМИНИСТРАТОР
# ============================================================

ADMIN_USER_ID = 8421476708
ADMIN_USERNAME = "VinnitSSki"


# ============================================================
# ОСНОВНЫЕ НАСТРОЙКИ
# ============================================================

DB_FILE = "bookings.db"

TIMEZONE = ZoneInfo("Asia/Yekaterinburg")

DAYS_AHEAD = 30

WORK_START_HOUR = 8
WORK_END_HOUR = 20

MAX_PEOPLE = 24

WEEKDAYS_RU = [
    "Пн",
    "Вт",
    "Ср",
    "Чт",
    "Пт",
    "Сб",
    "Вс",
]


# ============================================================
# БЛОКИРОВКА БАЗЫ
# ============================================================

db_lock = asyncio.Lock()


# ============================================================
# ПОДКЛЮЧЕНИЕ К SQLITE
# ============================================================

def get_connection() -> sqlite3.Connection:
    conn = sqlite3.connect(DB_FILE)
    conn.row_factory = sqlite3.Row
    return conn


# ============================================================
# СОЗДАНИЕ БАЗЫ
# ============================================================

def init_db() -> None:
    conn = get_connection()

    try:
        conn.executescript(
            """
            CREATE TABLE IF NOT EXISTS bookings (
                id INTEGER PRIMARY KEY AUTOINCREMENT,

                user_id INTEGER NOT NULL,

                username TEXT,

                name TEXT NOT NULL,

                date TEXT NOT NULL,

                time_start TEXT NOT NULL,

                time_end TEXT NOT NULL,

                people_count INTEGER NOT NULL,

                contact TEXT NOT NULL,

                purpose TEXT NOT NULL,

                status TEXT NOT NULL DEFAULT 'pending',

                created_at TEXT NOT NULL
            );


            CREATE UNIQUE INDEX IF NOT EXISTS
            idx_unique_active_slot

            ON bookings(date, time_start)

            WHERE status IN ('pending', 'approved');
            """
        )

        conn.commit()

    finally:
        conn.close()


# ============================================================
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ============================================================

def is_admin(user_id: int) -> bool:
    return user_id == ADMIN_USER_ID


def format_date_ru(date_str: str) -> str:
    d = datetime.strptime(
        date_str,
        "%Y-%m-%d",
    ).date()

    return d.strftime("%d.%m.%Y")


def slot_bounds(hour: int) -> Tuple[str, str]:
    return (
        f"{hour:02d}:00",
        f"{hour + 1:02d}:00",
    )


# ============================================================
# ПОЛУЧЕНИЕ ЗАНЯТЫХ ЧАСОВ
# ============================================================

def get_busy_hours(date_str: str) -> Set[int]:
    conn = get_connection()

    try:
        rows = conn.execute(
            """
            SELECT time_start
            FROM bookings

            WHERE date = ?

            AND status IN ('pending', 'approved')
            """,
            (date_str,),
        ).fetchall()

        return {
            int(
                row["time_start"].split(":")[0]
            )
            for row in rows
        }

    finally:
        conn.close()


# ============================================================
# СОЗДАНИЕ БРОНИ
# ============================================================

def create_booking(
    user_id: int,
    username: Optional[str],
    name: str,
    date_str: str,
    time_start: str,
    time_end: str,
    people_count: int,
    contact: str,
    purpose: str,
) -> int:

    conn = get_connection()

    try:
        cur = conn.execute(
            """
            INSERT INTO bookings (
                user_id,
                username,
                name,
                date,
                time_start,
                time_end,
                people_count,
                contact,
                purpose,
                status,
                created_at
            )

            VALUES (
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                'pending',
                ?
            )
            """,
            (
                user_id,
                username or "",
                name,
                date_str,
                time_start,
                time_end,
                people_count,
                contact,
                purpose,
                datetime.now(
                    TIMEZONE
                ).isoformat(
                    timespec="seconds"
                ),
            ),
        )

        conn.commit()

        return int(cur.lastrowid)

    finally:
        conn.close()


# ============================================================
# ПОЛУЧИТЬ БРОНЬ
# ============================================================

def get_booking(
    booking_id: int,
) -> Optional[sqlite3.Row]:

    conn = get_connection()

    try:
        return conn.execute(
            """
            SELECT *
            FROM bookings
            WHERE id = ?
            """,
            (booking_id,),
        ).fetchone()

    finally:
        conn.close()


# ============================================================
# ИЗМЕНИТЬ СТАТУС
# ============================================================

def set_booking_status(
    booking_id: int,
    status: str,
) -> None:

    conn = get_connection()

    try:
        conn.execute(
            """
            UPDATE bookings
            SET status = ?
            WHERE id = ?
            """,
            (
                status,
                booking_id,
            ),
        )

        conn.commit()

    finally:
        conn.close()


# ============================================================
# АКТИВНЫЕ БРОНИ
# ============================================================

def get_active_bookings() -> List[sqlite3.Row]:

    conn = get_connection()

    try:
        return conn.execute(
            """
            SELECT *
            FROM bookings

            WHERE status IN ('pending', 'approved')

            ORDER BY date, time_start
            """
        ).fetchall()

    finally:
        conn.close()


# ============================================================
# УДАЛИТЬ ВСЕ АКТИВНЫЕ БРОНИ
# ============================================================

def clear_all_active_bookings() -> List[sqlite3.Row]:

    conn = get_connection()

    try:

        rows = conn.execute(
            """
            SELECT *
            FROM bookings

            WHERE status IN ('pending', 'approved')
            """
        ).fetchall()

        conn.execute(
            """
            UPDATE bookings

            SET status = 'rejected'

            WHERE status IN ('pending', 'approved')
            """
        )

        conn.commit()

        return rows

    finally:
        conn.close()


# ============================================================
# FSM
# ============================================================

class BookingStates(StatesGroup):

    choosing_date = State()

    choosing_time = State()

    choosing_people = State()

    entering_name = State()

    entering_contact = State()

    entering_purpose = State()


class DeleteStates(StatesGroup):

    confirming = State()


# ============================================================
# КЛАВИАТУРА ГЛАВНОГО МЕНЮ
# ============================================================

def main_menu_keyboard():

    builder = InlineKeyboardBuilder()

    builder.button(
        text="📅 Забронировать аудиторию",
        callback_data="book_start",
    )

    builder.adjust(1)

    return builder.as_markup()


# ============================================================
# КЛАВИАТУРА ДАТ
# ============================================================

def date_keyboard():

    builder = InlineKeyboardBuilder()

    today = datetime.now(
        TIMEZONE
    ).date()

    for i in range(DAYS_AHEAD):

        d = today + timedelta(
            days=i
        )

        weekday = WEEKDAYS_RU[
            d.weekday()
        ]

        builder.button(
            text=(
                f"{d.strftime('%d.%m')} "
                f"{weekday}"
            ),
            callback_data=(
                f"date:{d.isoformat()}"
            ),
        )

    builder.adjust(3)

    return builder.as_markup()


# ============================================================
# КЛАВИАТУРА ВРЕМЕНИ
# ============================================================

def time_keyboard(
    date_str: str,
):

    busy_hours = get_busy_hours(
        date_str
    )

    builder = InlineKeyboardBuilder()

    has_free = False

    for hour in range(
        WORK_START_HOUR,
        WORK_END_HOUR,
    ):

        if hour in busy_hours:
            continue

        has_free = True

        start, end = slot_bounds(
            hour
        )

        builder.button(
            text=f"{start}–{end}",
            callback_data=(
                f"time:{hour:02d}"
            ),
        )

    if not has_free:
        return None

    builder.adjust(3)

    return builder.as_markup()


# ============================================================
# КОЛИЧЕСТВО ЛЮДЕЙ
# ============================================================

def people_keyboard():

    builder = InlineKeyboardBuilder()

    for n in range(
        1,
        MAX_PEOPLE + 1,
    ):

        builder.button(
            text=str(n),
            callback_data=f"people:{n}",
        )

    builder.adjust(6)

    return builder.as_markup()


# ============================================================
# КНОПКИ АДМИНИСТРАТОРА
# ============================================================

def admin_decision_keyboard(
    booking_id: int,
):

    builder = InlineKeyboardBuilder()

    builder.button(
        text="✅ ПОДТВЕРДИТЬ",
        callback_data=(
            f"approve:{booking_id}"
        ),
    )

    builder.button(
        text="❌ ОТКЛОНИТЬ",
        callback_data=(
            f"reject:{booking_id}"
        ),
    )

    builder.adjust(2)

    return builder.as_markup()


# ============================================================
# УДАЛЕНИЕ ВСЕХ
# ============================================================

def delete_confirm_keyboard():

    builder = InlineKeyboardBuilder()

    builder.button(
