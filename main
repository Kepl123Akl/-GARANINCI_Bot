        )

    except TelegramBadRequest:

        pass


# ============================================================
# ЗАПУСК
# ============================================================

async def main() -> None:

    # Создаём базу
    init_db()

    # Создаём бота
    bot = Bot(
        token=BOT_TOKEN
    )

    # Dispatcher
    dp = Dispatcher(
        storage=MemoryStorage()
    )

    # Подключаем router
    dp.include_router(
        router
    )

    logger.info(
        "=================================="
    )

    logger.info(
        "Бот ГАРАНИНЦЫ запускается..."
    )

    logger.info(
        "Администратор: %s",
        ADMIN_USER_ID,
    )

    logger.info(
        "Команда /reza включена."
    )

    logger.info(
        "=================================="
    )

    # Удаляем webhook
    # для работы через polling
    await bot.delete_webhook(
        drop_pending_updates=True
    )

    # Запускаем polling
    await dp.start_polling(
        bot
    )


# ============================================================
# START
# ============================================================

if __name__ == "__main__":

    asyncio.run(
        main()
    )
