# =====================================================
# ФАЙЛ .ENV ДОЛЖЕН СОДЕРЖАТЬ:
#
# BOT_TOKEN=токен_бота_от_BotFather
# ADMIN_CHAT_ID=telegram_id_администратора
# ADMIN_USER_ID=telegram_id_администратора
# ANNOUNCEMENT_CHAT_ID=-1001234567890
#
# ANNOUNCEMENT_CHAT_ID:
# - ID группы;
# - ID канала;
# - @username канала.
#
# Бот должен быть добавлен в группу или канал.
# В канале бот должен иметь право публиковать сообщения.
# =====================================================


load_dotenv()

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s",
)

logger = logging.getLogger("garanintsy-bot")


@dataclass(frozen=True)
class Config:
    bot_token: str
    admin_chat_id: int
    admin_user_id: int | None
    announcement_chat_id: str | None
    database_path: str
    timezone: str
    date_days_ahead: int

    @classmethod
    def from_env(cls) -> "Config":
        bot_token = os.getenv("BOT_TOKEN", "").strip()
        admin_chat_id = os.getenv("ADMIN_CHAT_ID", "").strip()
        admin_user_id = os.getenv("ADMIN_USER_ID", "").strip()
        announcement_chat_id = os.getenv(
            "ANNOUNCEMENT_CHAT_ID",
            "",
        ).strip()

        if not bot_token:
            raise RuntimeError(
                "В .env не указан BOT_TOKEN"
            )

        if not admin_chat_id:
            raise RuntimeError(
                "В .env не указан ADMIN_CHAT_ID"
            )

        return cls(
            bot_token=bot_token,
            admin_chat_id=int(admin_chat_id),
            admin_user_id=(
                int(admin_user_id)
                if admin_user_id
                else None
            ),
            announcement_chat_id=(
                announcement_chat_id
                if announcement_chat_id
                else None
            ),
            database_path=os.getenv(
                "DATABASE_PATH",
                "bookings.sqlite3",
            ),
            timezone=os.getenv(
                "TIMEZONE",
                "Asia/Yekaterinburg",
            ),
            date_days_ahead=max(
                1,
                int(
                    os.getenv(
                        "DATE_DAYS_AHEAD",
                        "30",
                    )
                ),
            ),
        )


CONFIG = Config.from_env()
TIMEZONE = ZoneInfo(CONFIG.timezone)


class BookingStates(StatesGroup):
    selecting_date = State()
    selecting_time = State()
    selecting_people = State()
    entering_name = State()
    entering_contact = State()
    entering_purpose = State()


class Database:
    def __init__(self, path: str):
        self.connection = sqlite3.connect(
            path,
            check_same_thread=False,
        )

        self.connection.row_factory = sqlite3.Row
        self.connection.execute(
            "PRAGMA journal_mode=WAL"
        )
        self.create_tables()

    def create_tables(self) -> None:
        self.connection.execute(
            """
            CREATE TABLE IF NOT EXISTS bookings (
                id TEXT PRIMARY KEY,
                user_id INTEGER NOT NULL,
                username TEXT,
                name TEXT NOT NULL,
                booking_date TEXT NOT NULL,
                booking_time TEXT NOT NULL,
                people INTEGER NOT NULL
                    CHECK (people >= 1 AND people <= 24),
                contact TEXT NOT NULL,
                purpose TEXT NOT NULL,
                status TEXT NOT NULL DEFAULT 'pending'
                    CHECK (
                        status IN (
                            'pending',
                            'approved',
                            'rejected',
                            'cancelled'
                        )
                    ),
                created_at TEXT NOT NULL
            )
            """
        )

        self.connection.execute(
            """
            CREATE INDEX IF NOT EXISTS bookings_slot_index
            ON bookings (
                booking_date,
                booking_time,
                status
            )
            """
        )

        self.connection.commit()

    def is_slot_busy(
        self,
        booking_date: str,
        booking_time: str,
    ) -> bool:
        row = self.connection.execute(
            """
            SELECT id
            FROM bookings
            WHERE booking_date = ?
              AND booking_time = ?
              AND status IN ('pending', 'approved')
            LIMIT 1
            """,
            (
                booking_date,
                booking_time,
            ),
        ).fetchone()

        return row is not None

    def create_booking(
        self,
        data: dict,
    ) -> str | None:
        booking_id = uuid.uuid4().hex[:10].upper()

        try:
            self.connection.execute(
                "BEGIN IMMEDIATE"
            )

            if self.is_slot_busy(
                data["booking_date"],
                data["booking_time"],
            ):
                self.connection.rollback()
                return None

            self.connection.execute(
                """
                INSERT INTO bookings (
                    id,
                    user_id,
                    username,
                    name,
                    booking_date,
                    booking_time,
                    people,
                    contact,
                    purpose,
                    status,
                    created_at
                )
                VALUES (
                    ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', ?
                )
                """,
                (
                    booking_id,
                    data["user_id"],
                    data.get("username"),
                    data["name"],
                    data["booking_date"],
                    data["booking_time"],
                    data["people"],
                    data["contact"],
                    data["purpose"],
                    datetime.now(
                        TIMEZONE
                    ).isoformat(
                        timespec="seconds"
                    ),
                ),
            )

            self.connection.commit()
            return booking_id

        except Exception:
            self.connection.rollback()
            raise

    def get_booking(
        self,
        booking_id: str,
    ) -> sqlite3.Row | None:
        return self.connection.execute(
            """
            SELECT *
            FROM bookings
            WHERE id = ?
            """,
            (booking_id,),
        ).fetchone()

    def approve_or_reject(
        self,
        booking_id: str,
        status: str,
    ) -> bool:
        cursor = self.connection.execute(
            """
            UPDATE bookings
            SET status = ?
            WHERE id = ?
              AND status = 'pending'
            """,
            (
                status,
                booking_id,
            ),
        )

        self.connection.commit()

        return cursor.rowcount == 1

    def cancel(self, booking_id: str) -> None:
        self.connection.execute(
            """
            UPDATE bookings
            SET status = 'cancelled'
            WHERE id = ?
            """,
            (booking_id,),
        )

        self.connection.commit()

    def close(self) -> None:
        self.connection.close()


DATABASE = Database(CONFIG.database_path)
ROUTER = Router()


WEEKDAYS = (
    "понедельник",
    "вторник",
    "среда",
    "четверг",
    "пятница",
    "суббота",
    "воскресенье",
)


def format_date(value: str) -> str:
    parsed = datetime.strptime(
        value,
        "%Y-%m-%d",
    )

    return parsed.strftime("%d.%m.%Y")


def get_time_slots() -> list[str]:
    """
    Временные слоты каждые полтора часа:
    08:00, 09:30, 11:00, 12:30,
    14:00, 15:30, 17:00, 18:30, 20:00.
    """

    slots = []

    current_minutes = 8 * 60
    end_minutes = 20 * 60

    while current_minutes <= end_minutes:
        hours = current_minutes // 60
        minutes = current_minutes % 60

        slots.append(
            f"{hours:02d}:{minutes:02d}"
        )

        current_minutes += 90

    if "20:00" not in slots:
        slots.append("20:00")

    return slots


def dates_keyboard() -> InlineKeyboardMarkup:
    builder = InlineKeyboardBuilder()

    today = datetime.now(TIMEZONE).date()

    for days in range(CONFIG.date_days_ahead):
        current = today + timedelta(days=days)

        builder.button(
            text=(
                f"{current:%d.%m} — "
                f"{WEEKDAYS[current.weekday()]}"
            ),
            callback_data=(
                f"date:{current.isoformat()}"
            ),
        )

    builder.adjust(1)

    return builder.as_markup()


def time_keyboard() -> InlineKeyboardMarkup:
    builder = InlineKeyboardBuilder()

    for time_slot in get_time_slots():
        builder.button(
            text=time_slot,
            callback_data=f"time:{time_slot}",
        )

    builder.adjust(3)

    return builder.as_markup()


def people_keyboard() -> InlineKeyboardMarkup:
    builder = InlineKeyboardBuilder()

    for people in range(1, 25):
        builder.button(
            text=str(people),
            callback_data=f"people:{people}",
        )

    builder.adjust(6)

    return builder.as_markup()


def contact_keyboard() -> ReplyKeyboardMarkup:
    return ReplyKeyboardMarkup(
        keyboard=[
            [
                KeyboardButton(
                    text="Отправить номер телефона",
                    request_contact=True,
                )
            ]
        ],
        resize_keyboard=True,
        one_time_keyboard=True,
    )


def admin_keyboard(
    booking_id: str,
) -> InlineKeyboardMarkup:
    return InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(
                    text="✅ Подтвердить",
                    callback_data=(
                        f"booking:approve:{booking_id}"
                    ),
                ),
                InlineKeyboardButton(
                    text="❌ Отклонить",
                    callback_data=(
                        f"booking:reject:{booking_id}"
                    ),
                ),
            ]
        ]
    )


def status_text(status: str) -> str:
    statuses = {
        "pending": "⏳ Ожидает решения",
        "approved": "✅ Подтверждена",
        "rejected": "❌ Отклонена",
        "cancelled": "⚠️ Отменена",
    }

    return statuses.get(status, status)


def admin_booking_text(
    booking: sqlite3.Row,
) -> str:
    username = booking["username"]

    if username:
        username_text = (
            f"@{html.escape(username)}"
        )
    else:
        username_text = "не указан"

    return (
        "<b>Новая заявка на бронирование "
        "«Гаранинцы»</b>\n\n"
        f"<b>Номер:</b> "
        f"<code>{booking['id']}</code>\n"
        f"<b>Статус:</b> "
        f"{status_text(booking['status'])}\n"
        f"<b>Дата:</b> "
        f"{format_date(booking['booking_date'])}\n"
        f"<b>Время:</b> "
        f"{booking['booking_time']}\n"
        f"<b>Количество людей:</b> "
        f"{booking['people']}\n"
        f"<b>Имя:</b> "
        f"{html.escape(booking['name'])}\n"
        f"<b>Контакт:</b> "
        f"{html.escape(booking['contact'])}\n"
        f"<b>Цель:</b> "
        f"{html.escape(booking['purpose'])}\n\n"
        f"<b>Telegram:</b> "
        f"{username_text}\n"
        f"<b>ID пользователя:</b> "
        f"<code>{booking['user_id']}</code>"
    )


def user_booking_text(
    booking: sqlite3.Row,
) -> str:
    return (
        f"<b>Заявка {booking['id']}</b>\n\n"
        f"<b>Дата:</b> "
        f"{format_date(booking['booking_date'])}\n"
        f"<b>Время:</b> "
        f"{booking['booking_time']}\n"
        f"<b>Количество людей:</b> "
        f"{booking['people']}\n"
        f"<b>Статус:</b> "
        f"{status_text(booking['status'])}"
    )


def announcement_text(
    booking: sqlite3.Row,
) -> str:
    """
    Публикация в группу или канал.
    Контакт и Telegram ID пользователя
    специально не публикуются.
    """

    return (
        "🎭 <b>Подтверждённая репетиция</b>\n\n"
        f"<b>Дата:</b> "
        f"{format_date(booking['booking_date'])}\n"
        f"<b>Время:</b> "
        f"{booking['booking_time']}\n"
        f"<b>Участников:</b> "
        f"{booking['people']}\n"
        f"<b>Цель:</b> "
        f"{html.escape(booking['purpose'])}\n\n"
        "Аудитория «Гаранинцы» забронирована."
    )


async def publish_announcement(
    bot: Bot,
    booking: sqlite3.Row,
) -> bool:
    if not CONFIG.announcement_chat_id:
        logger.warning(
            "ANNOUNCEMENT_CHAT_ID не задан"
        )
        return False

    await bot.send_message(
        chat_id=CONFIG.announcement_chat_id,
        text=announcement_text(booking),
    )

    return True


def admin_has_access(
    callback: CallbackQuery,
) -> bool:
    if CONFIG.admin_user_id is not None:
        return (
            callback.from_user.id
            == CONFIG.admin_user_id
        )

    return (
        callback.from_user.id
        == CONFIG.admin_chat_id
    )


@ROUTER.message(CommandStart())
async def start(
    message: Message,
    state: FSMContext,
) -> None:
    await state.clear()

    await message.answer(
        "Здравствуйте!\n\n"
        "Это бот бронирования театральной "
        "аудитории «Гаранинцы».\n\n"
        "Выберите дату:",
        reply_markup=dates_keyboard(),
    )

    await state.set_state(
        BookingStates.selecting_date
    )


@ROUTER.message(Command("cancel"))
async def cancel(
    message: Message,
    state: FSMContext,
) -> None:
    await state.clear()

    await message.answer(
        "Заявка отменена.\n\n"
        "Чтобы начать заново, отправьте /start.",
        reply_markup=ReplyKeyboardRemove(),
    )


@ROUTER.callback_query(
    BookingStates.selecting_date,
    F.data.startswith("date:"),
)
async def choose_date(
    callback: CallbackQuery,
    state: FSMContext,
) -> None:
    selected_date = callback.data.removeprefix(
        "date:"
    )

    try:
        parsed_date = date.fromisoformat(
            selected_date
        )
    except ValueError:
        await callback.answer(
            "Некорректная дата",
            show_alert=True,
        )
        return

    today = datetime.now(TIMEZONE).date()
    last_date = today + timedelta(
        days=CONFIG.date_days_ahead - 1
    )

    if not today <= parsed_date <= last_date:
        await callback.answer(
            "Эта дата недоступна",
            show_alert=True,
        )
        return

    await state.update_data(
        booking_date=selected_date
    )

    await state.set_state(
        BookingStates.selecting_time
    )

    await callback.message.edit_text(
        f"Дата: "
        f"<b>{format_date(selected_date)}</b>\n\n"
        "Выберите время.\n"
        "Слоты идут каждые полтора часа:",
        reply_markup=time_keyboard(),
    )

    await callback.answer()


@ROUTER.callback_query(
    BookingStates.selecting_time,
    F.data.startswith("time:"),
)
async def choose_time(
    callback: CallbackQuery,
    state: FSMContext,
) -> None:
    selected_time = callback.data.removeprefix(
        "time:"
    )

    if selected_time not in get_time_slots():
        await callback.answer(
            "Некорректное время",
            show_alert=True,
        )
        return

    data = await state.get_data()

    if DATABASE.is_slot_busy(
        data["booking_date"],
        selected_time,
    ):
        await callback.answer(
            "Это время уже занято. "
            "Выберите другой слот.",
            show_alert=True,
        )
        return

    await state.update_data(
        booking_time=selected_time
    )

    await state.set_state(
        BookingStates.selecting_people
    )

    await callback.message.edit_text(
        f"Дата: "
        f"<b>{format_date(data['booking_date'])}</b>\n"
        f"Время: <b>{selected_time}</b>\n\n"
        "Выберите количество людей:",
        reply_markup=people_keyboard(),
    )

    await callback.answer()


@ROUTER.callback_query(
    BookingStates.selecting_people,
    F.data.startswith("people:"),
)
async def choose_people(
    callback: CallbackQuery,
    state: FSMContext,
) -> None:
    try:
        people = int(
            callback.data.removeprefix("people:")
        )
    except ValueError:
        await callback.answer(
            "Некорректное количество",
            show_alert=True,
        )
        return

    if not 1 <= people <= 24:
        await callback.answer(
            "Количество должно быть от 1 до 24",
            show_alert=True,
        )
        return

    await state.update_data(
        people=people
    )

    await state.set_state(
        BookingStates.entering_name
    )

    await callback.message.edit_text(
        "Введите ваше имя "
        "или название организации:"
    )

    await callback.answer()


@ROUTER.message(
    BookingStates.entering_name
)
async def enter_name(
    message: Message,
    state: FSMContext,
) -> None:
    name = (message.text or "").strip()

    if len(name) < 2 or len(name) > 100:
        await message.answer(
            "Имя должно содержать "
            "от 2 до 100 символов."
        )
        return

    await state.update_data(
        name=name
    )

    await state.set_state(
        BookingStates.entering_contact
    )

    await message.answer(
        "Введите номер телефона "
        "или другой контакт:",
        reply_markup=contact_keyboard(),
    )


@ROUTER.message(
    BookingStates.entering_contact
)
async def enter_contact(
    message: Message,
    state: FSMContext,
) -> None:
    if message.contact:
        contact = (
            message.contact.phone_number.strip()
        )
    else:
        contact = (message.text or "").strip()

    if len(contact) < 3 or len(contact) > 150:
        await message.answer(
            "Введите корректный контакт."
        )
        return

    await state.update_data(
        contact=contact
    )

    await state.set_state(
        BookingStates.entering_purpose
    )

    await message.answer(
        "Опишите цель бронирования.\n\n"
        "Например: репетиция спектакля, "
        "репетиция танцев или постановка."
    )


@ROUTER.message(
    BookingStates.entering_purpose
)
async def enter_purpose(
    message: Message,
    state: FSMContext,
    bot: Bot,
) -> None:
    purpose = (message.text or "").strip()

    if len(purpose) < 3 or len(purpose) > 500:
        await message.answer(
            "Цель должна содержать "
            "от 3 до 500 символов."
        )
        return

    data = await state.get_data()

    booking_data = {
        "user_id": message.from_user.id,
        "username": message.from_user.username,
        "name": data["name"],
        "booking_date": data["booking_date"],
        "booking_time": data["booking_time"],
        "people": data["people"],
        "contact": data["contact"],
        "purpose": purpose,
    }

    booking_id = DATABASE.create_booking(
        booking_data
    )

    if booking_id is None:
        await state.clear()

        await message.answer(
            "Этот слот только что заняли.\n\n"
            "Отправьте /start и выберите "
            "другое время.",
            reply_markup=ReplyKeyboardRemove(),
        )
        return

    booking = DATABASE.get_booking(booking_id)

    try:
        await bot.send_message(
            chat_id=CONFIG.admin_chat_id,
            text=admin_booking_text(booking),
            reply_markup=admin_keyboard(booking_id),
        )
    except Exception:
        logger.exception(
            "Ошибка отправки заявки администратору"
        )

        DATABASE.cancel(booking_id)
        await state.clear()

        await message.answer(
            "Не удалось отправить заявку "
            "администратору.\n"
            "Попробуйте позже.",
            reply_markup=ReplyKeyboardRemove(),
        )
        return

    await state.clear()

    await message.answer(
        "Заявка отправлена администратору.\n\n"
        f"{user_booking_text(booking)}\n\n"
        "После решения администратора "
        "вы получите уведомление.",
        reply_markup=ReplyKeyboardRemove(),
    )


@ROUTER.callback_query(
    F.data.startswith("booking:")
)
async def admin_decision(
    callback: CallbackQuery,
    bot: Bot,
) -> None:
    if not admin_has_access(callback):
        await callback.answer(
            "У вас нет доступа.",
            show_alert=True,
        )
        return

    parts = callback.data.split(":")

    if len(parts) != 3:
        await callback.answer(
            "Некорректная команда.",
            show_alert=True,
        )
        return

    action = parts[1]
    booking_id = parts[2]

    if action not in {"approve", "reject"}:
        await callback.answer(
            "Некорректное действие.",
            show_alert=True,
        )
        return

    booking = DATABASE.get_booking(booking_id)

    if booking is None:
        await callback.answer(
            "Заявка не найдена.",
            show_alert=True,
        )
        return

    new_status = (
        "approved"
        if action == "approve"
        else "rejected"
    )

    changed = DATABASE.approve_or_reject(
        booking_id,
        new_status,
    )

    if not changed:
        await callback.answer(
            "Заявка уже обработана.",
            show_alert=True,
        )
        return

    booking = DATABASE.get_booking(booking_id)

    try:
        await callback.message.edit_text(
            admin_booking_text(booking)
        )
    except Exception:
        logger.exception(
            "Не удалось обновить сообщение "
            "администратора"
        )

    if new_status == "approved":
        user_text = (
            "✅ Администратор подтвердил "
            "вашу заявку.\n\n"
        )
    else:
        user_text = (
            "❌ Администратор отклонил "
            "вашу заявку.\n\n"
        )

    try:
        await bot.send_message(
            chat_id=booking["user_id"],
            text=(
                user_text
                + user_booking_text(booking)
            ),
        )
    except Exception:
        logger.warning(
            "Не удалось уведомить пользователя"
        )

    published = False

    if new_status == "approved":
        try:
            published = await publish_announcement(
                bot,
                booking,
            )
        except Exception:
            logger.exception(
                "Не удалось опубликовать заявку "
                "в группе или канале"
            )

    if new_status == "approved":
        if published:
            await callback.answer(
                "Заявка подтверждена и опубликована."
            )
        else:
            await callback.answer(
                "Заявка подтверждена, "
                "но публикация не выполнена."
            )
    else:
        await callback.answer(
            "Заявка отклонена."
        )


async def main() -> None:
    bot = Bot(
        token=CONFIG.bot_token,
        default=DefaultBotProperties(
            parse_mode=ParseMode.HTML
        ),
    )

    dispatcher = Dispatcher()
    dispatcher.include_router(ROUTER)

    logger.info(
        "Бот запущен"
    )

    logger.info(
        "Временные слоты: %s",
        ", ".join(get_time_slots()),
    )

    if CONFIG.announcement_chat_id:
        logger.info(
            "Публикации будут отправляться в: %s",
            CONFIG.announcement_chat_id,
        )
    else:
        logger.warning(
            "ANNOUNCEMENT_CHAT_ID не указан"
        )

    try:
        await dispatcher.start_polling(bot)
    finally:
        DATABASE.close()
        await bot.session.close()


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        logger.info("Бот остановлен")
