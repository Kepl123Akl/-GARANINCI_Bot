import asyncio
import logging
import os
import sqlite3
from datetime import datetime, timedelta
from typing import Optional
from zoneinfo import ZoneInfo

from aiogram import Bot, Dispatcher, F, Router
from aiogram.exceptions import TelegramBadRequest, TelegramForbiddenError
from aiogram.filters import Command, CommandStart
from aiogram.fsm.context import FSMContext
from aiogram.fsm.state import State, StatesGroup
from aiogram.fsm.storage.memory import MemoryStorage
from aiogram.types import CallbackQuery, ChatMemberUpdated, Message
from aiogram.utils.keyboard import InlineKeyboardBuilder


# ============================================================
# НАСТРОЙКИ
# ============================================================

BOT_TOKEN = os.getenv("BOT_TOKEN") or os.getenv("TOKEN")

if not BOT_TOKEN:
    raise RuntimeError(
        "Не найден BOT_TOKEN. Добавьте токен бота в переменные BotHost."
    )

ADMIN_USER_ID = 8421476708

DB_FILE = "bookings.db"

TIMEZONE = ZoneInfo("Asia/Yekaterinburg")

DAYS_AHEAD = 30

WORK_START_HOUR = 8
WORK_END_HOUR = 20

MAX_PEOPLE = 24

WEEKDAYS_RU = [
    "Пн",
    "Вт",
    "Ср",
    "Чт",
    "Пт",
    "Сб",
    "Вс",
]


# ============================================================
# LOGGING
# ============================================================

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s",
)

logger = logging.getLogger("GARANINCI")


# ============================================================
# DATABASE
# ============================================================

def get_connection():
    conn = sqlite3.connect(
        DB_FILE,
        timeout=30,
    )
    conn.row_factory = sqlite3.Row
    return conn


def init_db():
    conn = get_connection()

    try:
        conn.executescript(
            """
            CREATE TABLE IF NOT EXISTS bookings (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER NOT NULL,
                username TEXT,
                name TEXT NOT NULL,
                date TEXT NOT NULL,
                time_start TEXT NOT NULL,
                time_end TEXT NOT NULL,
                people_count INTEGER NOT NULL,
                contact TEXT NOT NULL,
                purpose TEXT NOT NULL,
                status TEXT NOT NULL DEFAULT 'pending',
                created_at TEXT NOT NULL
            );

            CREATE UNIQUE INDEX IF NOT EXISTS
            idx_unique_active_slot
            ON bookings(date, time_start)
            WHERE status IN ('pending', 'approved');

            CREATE TABLE IF NOT EXISTS announcement_chats (
                chat_id INTEGER PRIMARY KEY,
                chat_type TEXT NOT NULL,
                title TEXT,
                created_at TEXT NOT NULL
            );
            """
        )

        conn.commit()

    finally:
        conn.close()


# ============================================================
# ГРУППЫ И КАНАЛЫ
# ============================================================

def save_announcement_chat(
    chat_id: int,
    chat_type: str,
    title: str,
):
    conn = get_connection()

    try:
        conn.execute(
            """
            INSERT OR REPLACE INTO announcement_chats
            (
                chat_id,
                chat_type,
                title,
                created_at
            )
            VALUES (?, ?, ?, ?)
            """,
            (
                chat_id,
                chat_type,
                title or "",
                datetime.now(TIMEZONE).isoformat(
                    timespec="seconds"
                ),
            ),
        )

        conn.commit()

    finally:
        conn.close()

    logger.info(
        "Чат зарегистрирован: id=%s type=%s title=%s",
        chat_id,
        chat_type,
        title,
    )


def remove_announcement_chat(chat_id: int):
    conn = get_connection()

    try:
        conn.execute(
            """
            DELETE FROM announcement_chats
            WHERE chat_id = ?
            """,
            (chat_id,),
        )

        conn.commit()

    finally:
        conn.close()

    logger.info(
        "Чат удалён из списка: %s",
        chat_id,
    )


def get_announcement_chats():
    conn = get_connection()

    try:
        return conn.execute(
            """
            SELECT *
            FROM announcement_chats
            ORDER BY title
            """
        ).fetchall()

    finally:
        conn.close()


# ============================================================
# АВТОМАТИЧЕСКАЯ РЕГИСТРАЦИЯ ГРУПП И КАНАЛОВ
# ============================================================

router = Router()


@router.my_chat_member()
async def bot_chat_member_update(
    event: ChatMemberUpdated,
):
    chat = event.chat
    new_status = event.new_chat_member.status

    logger.info(
        "Изменение статуса бота: chat_id=%s type=%s title=%s status=%s",
        chat.id,
        chat.type,
        chat.title,
        new_status,
    )

    if new_status in (
        "member",
        "administrator",
    ):
        if chat.type in (
            "group",
            "supergroup",
            "channel",
        ):
            save_announcement_chat(
                chat_id=chat.id,
                chat_type=chat.type,
                title=chat.title or "",
            )

    elif new_status in (
        "left",
        "kicked",
    ):
        remove_announcement_chat(chat.id)


# ============================================================
# ОТПРАВКА ОБЪЯВЛЕНИЯ ВО ВСЕ ГРУППЫ И КАНАЛЫ
# ============================================================

async def send_announcement_to_all_chats(
    bot: Bot,
    text: str,
):
    chats = get_announcement_chats()

    if not chats:
        logger.warning(
            "НЕТ ЗАРЕГИСТРИРОВАННЫХ ГРУПП И КАНАЛОВ."
        )
        return 0

    success_count = 0

    logger.info(
        "Начинаем публикацию в %s чатов.",
        len(chats),
    )

    for chat in chats:
        chat_id = chat["chat_id"]
        chat_title = chat["title"] or str(chat_id)

        try:
            await bot.send_message(
                chat_id=chat_id,
                text=text,
            )

            success_count += 1

            logger.info(
                "Сообщение успешно отправлено: %s (%s)",
                chat_title,
                chat_id,
            )

        except TelegramForbiddenError:
            logger.warning(
                "Нет прав для отправки в %s (%s). Чат удалён из списка.",
                chat_title,
                chat_id,
            )

            remove_announcement_chat(chat_id)

        except TelegramBadRequest as exc:
            logger.error(
                "Telegram BadRequest в %s (%s): %s",
                chat_title,
                chat_id,
                exc,
            )

        except Exception as exc:
            logger.exception(
                "Ошибка отправки в %s (%s): %s",
                chat_title,
                chat_id,
                exc,
            )

        await asyncio.sleep(0.3)

    logger.info(
        "Публикация завершена. Успешно: %s из %s.",
        success_count,
        len(chats),
    )

    return success_count


# ============================================================
# FSM
# ============================================================

class BookingStates(StatesGroup):
    choosing_date = State()
    choosing_time = State()
    choosing_people = State()
    entering_name = State()
    entering_contact = State()
    entering_purpose = State()


class DeleteStates(StatesGroup):
    confirming = State()


# ============================================================
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ============================================================

def is_admin(user_id: Optional[int]) -> bool:
    return user_id == ADMIN_USER_ID


def format_date_ru(date_str: str) -> str:
    date = datetime.strptime(
        date_str,
        "%Y-%m-%d",
    ).date()

    return date.strftime("%d.%m.%Y")


def slot_bounds(hour: int):
    return (
        f"{hour:02d}:00",
        f"{hour + 1:02d}:00",
    )


# ============================================================
# КЛАВИАТУРЫ
# ============================================================

def main_menu_keyboard():
    builder = InlineKeyboardBuilder()

    builder.button(
        text="Забронировать аудиторию",
        callback_data="book_start",
    )

    builder.adjust(1)

    return builder.as_markup()


def date_keyboard():
    builder = InlineKeyboardBuilder()

    today = datetime.now(TIMEZONE).date()

    for i in range(DAYS_AHEAD):
        date = today + timedelta(days=i)

        weekday = WEEKDAYS_RU[
            date.weekday()
        ]

        builder.button(
            text=(
                f"{date.strftime('%d.%m')} "
                f"{weekday}"
            ),
            callback_data=(
                f"date:{date.isoformat()}"
            ),
        )

    builder.adjust(3)

    return builder.as_markup()


def get_busy_hours(date_str: str):
    conn = get_connection()

    try:
        rows = conn.execute(
            """
            SELECT time_start
            FROM bookings
            WHERE date = ?
            AND status IN ('pending', 'approved')
            """,
            (date_str,),
        ).fetchall()

        return {
            int(
                row["time_start"].split(":")[0]
            )
            for row in rows
        }

    finally:
        conn.close()


def time_keyboard(date_str: str):
    busy = get_busy_hours(date_str)

    builder = InlineKeyboardBuilder()

    free_count = 0

    for hour in range(
        WORK_START_HOUR,
        WORK_END_HOUR,
    ):
        if hour in busy:
            continue

        start, end = slot_bounds(hour)

        builder.button(
            text=f"{start}–{end}",
            callback_data=f"time:{hour}",
        )

        free_count += 1

    if free_count == 0:
        return None

    builder.adjust(3)

    return builder.as_markup()


def people_keyboard():
    builder = InlineKeyboardBuilder()

    for people in range(
        1,
        MAX_PEOPLE + 1,
    ):
        builder.button(
            text=str(people),
            callback_data=f"people:{people}",
        )

    builder.adjust(6)

    return builder.as_markup()


def admin_decision_keyboard(
    booking_id: int,
):
    builder = InlineKeyboardBuilder()

    builder.button(
        text="ПОДТВЕРДИТЬ",
        callback_data=f"approve:{booking_id}",
    )

    builder.button(
        text="ОТКЛОНИТЬ",
        callback_data=f"reject:{booking_id}",
    )

    builder.adjust(2)

    return builder.as_markup()


def delete_confirm_keyboard():
    builder = InlineKeyboardBuilder()

    builder.button(
        text="Да, удалить всё",
        callback_data="delete_confirm",
    )

    builder.button(
        text="Отмена",
        callback_data="delete_cancel",
    )

    builder.adjust(1)

    return builder.as_markup()


# ============================================================
# БРОНИРОВАНИЯ
# ============================================================

def create_booking(
    user_id: int,
    username: Optional[str],
    name: str,
    date_str: str,
    time_start: str,
    time_end: str,
    people_count: int,
    contact: str,
    purpose: str,
):
    conn = get_connection()

    try:
        cursor = conn.execute(
            """
            INSERT INTO bookings
            (
                user_id,
                username,
                name,
                date,
                time_start,
                time_end,
                people_count,
                contact,
                purpose,
                status,
                created_at
            )
            VALUES
            (
                ?, ?, ?, ?, ?, ?,
                ?, ?, ?, 'pending', ?
            )
            """,
            (
                user_id,
                username or "",
                name,
                date_str,
                time_start,
                time_end,
                people_count,
                contact,
                purpose,
                datetime.now(TIMEZONE).isoformat(
                    timespec="seconds"
                ),
            ),
        )

        conn.commit()

        return cursor.lastrowid

    finally:
        conn.close()


def get_booking(booking_id: int):
    conn = get_connection()

    try:
        return conn.execute(
            """
            SELECT *
            FROM bookings
            WHERE id = ?
            """,
            (booking_id,),
        ).fetchone()

    finally:
        conn.close()


def set_booking_status(
    booking_id: int,
    status: str,
):
    conn = get_connection()

    try:
        conn.execute(
            """
            UPDATE bookings
            SET status = ?
            WHERE id = ?
            """,
            (
                status,
                booking_id,
            ),
        )

        conn.commit()

    finally:
        conn.close()


def get_active_bookings():
    conn = get_connection()

    try:
        return conn.execute(
            """
            SELECT *
            FROM bookings
            WHERE status IN ('pending', 'approved')
            ORDER BY date, time_start
            """
        ).fetchall()

    finally:
        conn.close()


def clear_all_active_bookings():
    conn = get_connection()

    try:
        rows = conn.execute(
            """
            SELECT *
            FROM bookings
            WHERE status IN ('pending', 'approved')
            """
        ).fetchall()

        conn.execute(
            """
            UPDATE bookings
            SET status = 'rejected'
            WHERE status IN ('pending', 'approved')
            """
        )

        conn.commit()

        return rows

    finally:
        conn.close()


# ============================================================
# /START
# ============================================================

@router.message(CommandStart())
async def start_command(
    message: Message,
    state: FSMContext,
):
    await state.clear()

    if message.chat.type in (
        "group",
        "supergroup",
        "channel",
    ):
        save_announcement_chat(
            chat_id=message.chat.id,
            chat_type=message.chat.type,
            title=message.chat.title or "",
        )

    await message.answer(
        "ГАРАНИНЦЫ\n\n"
        "Добро пожаловать!\n\n"
        "Выберите действие:",
        reply_markup=main_menu_keyboard(),
    )


# ============================================================
# /BOOK
# ============================================================

@router.message(Command("book"))
async def book_command(
    message: Message,
    state: FSMContext,
):
    await state.clear()

    await state.set_state(
        BookingStates.choosing_date
    )

    await message.answer(
        "Выберите дату:",
        reply_markup=date_keyboard(),
    )


# ============================================================
# КНОПКА ЗАБРОНИРОВАТЬ
# ============================================================

@router.callback_query(
    F.data == "book_start"
)
async def book_start_callback(
    callback: CallbackQuery,
    state: FSMContext,
):
    await callback.answer()

    await state.clear()

    await state.set_state(
        BookingStates.choosing_date
    )

    await callback.message.answer(
        "Выберите дату:",
        reply_markup=date_keyboard(),
    )


# ============================================================
# ДАТА
# ============================================================

@router.callback_query(
    BookingStates.choosing_date,
    F.data.startswith("date:"),
)
async def choose_date(
    callback: CallbackQuery,
    state: FSMContext,
):
    date_str = callback.data.split(
        ":",
        1,
    )[1]

    keyboard = time_keyboard(date_str)

    if keyboard is None:
        await callback.answer()

        await callback.message.answer(
            "На эту дату всё занято.\n\n"
            "Выберите другую дату:",
            reply_markup=date_keyboard(),
        )

        return

    await callback.answer()

    await state.update_data(
        date=date_str
    )

    await state.set_state(
        BookingStates.choosing_time
    )

    await callback.message.answer(
        f"Дата: {format_date_ru(date_str)}\n\n"
        "Выберите время:",
        reply_markup=keyboard,
    )


# ============================================================
# ВРЕМЯ
# ============================================================

@router.callback_query(
    BookingStates.choosing_time,
    F.data.startswith("time:"),
)
async def choose_time(
    callback: CallbackQuery,
    state: FSMContext,
):
    data = await state.get_data()

    date_str = data.get("date")

    if not date_str:
        await callback.answer(
            "Сессия устарела.",
            show_alert=True,
        )

        await state.clear()

        return

    hour = int(
        callback.data.split(
            ":",
            1,
        )[1]
    )

    busy = get_busy_hours(date_str)

    if hour in busy:
        await callback.answer(
            "Это время уже занято.",
            show_alert=True,
        )

        return

    await callback.answer()

    start, end = slot_bounds(hour)

    await state.update_data(
        time_start=start,
        time_end=end,
    )

    await state.set_state(
        BookingStates.choosing_people
    )

    await callback.message.answer(
        f"Время: {start}–{end}\n\n"
        "Сколько будет человек?",
        reply_markup=people_keyboard(),
    )


# ============================================================
# КОЛИЧЕСТВО ЛЮДЕЙ
# ============================================================

@router.callback_query(
    BookingStates.choosing_people,
    F.data.startswith("people:"),
)
async def choose_people(
    callback: CallbackQuery,
    state: FSMContext,
):
    people = int(
        callback.data.split(
            ":",
            1,
        )[1]
    )

    if people < 1 or people > MAX_PEOPLE:
        await callback.answer(
            "Недопустимое количество.",
            show_alert=True,
        )

        return

    await callback.answer()

    await state.update_data(
        people_count=people
    )

    await state.set_state(
        BookingStates.entering_name
    )

    await callback.message.answer(
        "Введите ваше имя:"
    )


# ============================================================
# ИМЯ
# ============================================================

@router.message(
    BookingStates.entering_name,
    F.text,
)
async def enter_name(
    message: Message,
    state: FSMContext,
):
    name = message.text.strip()

    if not name:
        await message.answer(
            "Введите имя."
        )

        return

    await state.update_data(
        name=name
    )

    await state.set_state(
        BookingStates.entering_contact
    )

    await message.answer(
        "Введите контактный номер "
        "или другой способ связи:"
    )


# ============================================================
# КОНТАКТ
# ============================================================

@router.message(
    BookingStates.entering_contact,
    F.text,
)
async def enter_contact(
    message: Message,
    state: FSMContext,
):
    contact = message.text.strip()

    if not contact:
        await message.answer(
            "Введите контакт."
        )

        return

    await state.update_data(
        contact=contact
    )

    await state.set_state(
        BookingStates.entering_purpose
    )

    await message.answer(
        "Для чего бронируете аудиторию?"
    )


# ============================================================
# ЦЕЛЬ И СОЗДАНИЕ ЗАЯВКИ
# ============================================================

@router.message(
    BookingStates.entering_purpose,
    F.text,
)
async def enter_purpose(
    message: Message,
    state: FSMContext,
):
    purpose = message.text.strip()

    if not purpose:
        await message.answer(
            "Введите цель бронирования."
        )

        return

    data = await state.get_data()

    date_str = data["date"]
    time_start = data["time_start"]
    time_end = data["time_end"]
    people_count = data["people_count"]
    name = data["name"]
    contact = data["contact"]

    busy = get_busy_hours(date_str)

    hour = int(
        time_start.split(":")[0]
    )

    if hour in busy:
        await state.set_state(
            BookingStates.choosing_time
        )

        keyboard = time_keyboard(date_str)

        if keyboard:
            await message.answer(
                "Это время уже заняли.\n\n"
                "Выберите другое:",
                reply_markup=keyboard,
            )
        else:
            await state.set_state(
                BookingStates.choosing_date
            )

            await message.answer(
                "На эту дату больше "
                "нет свободного времени.",
                reply_markup=date_keyboard(),
            )

        return

    try:
        booking_id = create_booking(
            user_id=message.from_user.id,
            username=message.from_user.username,
            name=name,
            date_str=date_str,
            time_start=time_start,
            time_end=time_end,
            people_count=people_count,
            contact=contact,
            purpose=purpose,
        )

    except sqlite3.IntegrityError:
        await message.answer(
            "Это время только что заняли. "
            "Попробуйте выбрать другое."
        )

        await state.set_state(
            BookingStates.choosing_time
        )

        keyboard = time_keyboard(date_str)

        if keyboard:
            await message.answer(
                "Свободное время:",
                reply_markup=keyboard,
            )

        return

    await state.clear()

    await message.answer(
        "Заявка отправлена администратору.\n\n"
        f"Дата: {format_date_ru(date_str)}\n"
        f"Время: {time_start}–{time_end}\n"
        f"Людей: {people_count}\n\n"
        "Ожидайте подтверждения."
    )

    username = (
        f"@{message.from_user.username}"
        if message.from_user.username
        else "нет username"
    )

    admin_text = (
        "НОВАЯ ЗАЯВКА\n\n"
        f"Заявка №{booking_id}\n\n"
        f"Дата: {format_date_ru(date_str)}\n"
        f"Время: {time_start}–{time_end}\n"
        f"Людей: {people_count}\n\n"
        f"Имя: {name}\n"
        f"Контакт: {contact}\n"
        f"Цель: {purpose}\n\n"
        f"Telegram: {username}\n"
        f"ID пользователя: {message.from_user.id}"
    )

    try:
        await message.bot.send_message(
            chat_id=ADMIN_USER_ID,
            text=admin_text,
            reply_markup=admin_decision_keyboard(
                booking_id
            ),
        )

    except Exception as exc:
        logger.exception(
            "Не удалось отправить заявку админу: %s",
            exc,
        )


# ============================================================
# ПОДТВЕРЖДЕНИЕ
# ============================================================

@router.callback_query(
    F.data.startswith("approve:")
)
async def approve_booking(
    callback: CallbackQuery,
):
    if not is_admin(
        callback.from_user.id
    ):
        await callback.answer(
            "Нет прав.",
            show_alert=True,
        )

        return

    booking_id = int(
        callback.data.split(
            ":",
            1,
        )[1]
    )

    booking = get_booking(booking_id)

    if booking is None:
        await callback.answer(
            "Заявка не найдена.",
            show_alert=True,
        )

        return

    if booking["status"] != "pending":
        await callback.answer(
            "Заявка уже обработана.",
            show_alert=True,
        )

        return

    # ========================================================
    # ПОДТВЕРЖДАЕМ БРОНЬ
    # ========================================================

    set_booking_status(
        booking_id,
        "approved",
    )

    await callback.answer(
        "Запись подтверждена."
    )

    # ========================================================
    # ОБНОВЛЯЕМ СООБЩЕНИЕ АДМИНА
    # ========================================================

    try:
        await callback.message.edit_text(
            callback.message.text
            + "\n\n"
            + "ПОДТВЕРЖДЕНО"
        )

    except TelegramBadRequest:
        pass

    # ========================================================
    # ФОРМИРУЕМ ДАННЫЕ
    # ========================================================

    date_ru = format_date_ru(
        booking["date"]
    )

    time_start = booking["time_start"]
    time_end = booking["time_end"]

    # ========================================================
    # УВЕДОМЛЯЕМ ПОЛЬЗОВАТЕЛЯ
    # ========================================================

    try:
        await callback.bot.send_message(
            chat_id=booking["user_id"],
            text=(
                "РЕПЕТИЦИЯ ПОДТВЕРЖДЕНА\n\n"
                f"Дата: {date_ru}\n"
                f"Время: {time_start}–{time_end}\n"
                f"Людей: {booking['people_count']}\n\n"
                "Ваша запись подтверждена."
            ),
        )

    except (
        TelegramBadRequest,
        TelegramForbiddenError,
    ) as exc:
        logger.warning(
            "Не удалось уведомить пользователя %s: %s",
            booking["user_id"],
            exc,
        )

    # ========================================================
    # ГЛАВНОЕ:
    # ПУБЛИКАЦИЯ В ГРУППЫ И КАНАЛЫ
    # ========================================================

    announcement_text = (
        "📢 АУДИТОРИЯ ЗАНЯТА\n\n"
        f"📅 Дата: {date_ru}\n"
        f"⏰ Время: {time_start}–{time_end}\n"
        f"👥 Количество: {booking['people_count']} человек\n"
        f"👤 Имя: {booking['name']}\n"
        f"📞 Контакт: {booking['contact']}\n"
        f"🎭 Цель: {booking['purpose']}\n\n"
        "🔒 Аудитория занята на указанное время."
    )

    sent_count = await send_announcement_to_all_chats(
        callback.bot,
        announcement_text,
    )

    # ========================================================
    # СООБЩЕНИЕ АДМИНУ О РЕЗУЛЬТАТЕ ПУБЛИКАЦИИ
    # ========================================================

    chats = get_announcement_chats()

    if chats:
        logger.info(
            "После подтверждения публикация выполнена. "
            "Зарегистрированных чатов осталось: %s. "
            "Успешных отправок: %s.",
            len(chats),
            sent_count,
        )
    else:
        logger.warning(
            "После подтверждения НЕТ зарегистрированных "
            "групп/каналов."
        )

        try:
            await callback.bot.send_message(
                chat_id=ADMIN_USER_ID,
                text=(
                    "⚠️ Запись подтверждена, "
                    "но групп/каналов для публикации не найдено.\n\n"
                    "Добавьте бота в группу/канал и выполните "
                    "там /register."
                ),
            )

        except Exception:
            pass


# ============================================================
# ОТКЛОНЕНИЕ
# ============================================================

@router.callback_query(
    F.data.startswith("reject:")
)
async def reject_booking(
    callback: CallbackQuery,
):
    if not is_admin(
        callback.from_user.id
    ):
        await callback.answer(
            "Нет прав.",
            show_alert=True,
        )

        return

    booking_id = int(
        callback.data.split(
            ":",
            1,
        )[1]
    )

    booking = get_booking(booking_id)

    if booking is None:
        await callback.answer(
            "Заявка не найдена.",
            show_alert=True,
        )

        return

    if booking["status"] != "pending":
        await callback.answer(
            "Заявка уже обработана.",
            show_alert=True,
        )

        return

    set_booking_status(
        booking_id,
        "rejected",
    )

    await callback.answer(
        "Отклонено."
    )

    try:
        await callback.message.edit_text(
            callback.message.text
            + "\n\n"
            + "ОТКЛОНЕНО"
        )

    except TelegramBadRequest:
        pass

    try:
        await callback.bot.send_message(
            chat_id=booking["user_id"],
            text=(
                "Бронирование отклонено.\n\n"
                f"Дата: {format_date_ru(booking['date'])}\n"
                f"Время: "
                f"{booking['time_start']}–"
                f"{booking['time_end']}"
            ),
        )

    except (
        TelegramBadRequest,
        TelegramForbiddenError,
    ):
        pass


# ============================================================
# /CHATS
# ============================================================

@router.message(
    Command("chats")
)
async def chats_command(
    message: Message,
):
    if not is_admin(
        message.from_user.id
    ):
        await message.answer(
            "Нет прав администратора."
        )

        return

    chats = get_announcement_chats()

    if not chats:
        await message.answer(
            "Зарегистрированных групп и каналов нет."
        )

        return

    text = (
        f"ЗАРЕГИСТРИРОВАННЫЕ ЧАТЫ: {len(chats)}\n\n"
    )

    for index, chat in enumerate(
        chats,
        start=1,
    ):
        text += (
            f"{index}. {chat['title'] or 'Без названия'}\n"
            f"Тип: {chat['chat_type']}\n"
            f"ID: {chat['chat_id']}\n\n"
        )

    await message.answer(text)


# ============================================================
# /REGISTER
# ============================================================

@router.message(
    Command("register")
)
async def register_command(
    message: Message,
):
    if not is_admin(
        message.from_user.id
    ):
        await message.answer(
            "Нет прав администратора."
        )

        return

    if message.chat.type not in (
        "group",
        "supergroup",
        "channel",
    ):
        await message.answer(
            "Эту команду нужно использовать "
            "в группе или канале, куда бот должен "
            "отправлять подтверждённые записи."
        )

        return

    save_announcement_chat(
        chat_id=message.chat.id,
        chat_type=message.chat.type,
        title=message.chat.title or "",
    )

    await message.answer(
        "✅ Этот чат зарегистрирован.\n\n"
        "Теперь после подтверждения записи "
        "информация об аудитории будет "
        "отправляться сюда."
    )


# ============================================================
# /REZA
# ============================================================

@router.message(
    Command("reza")
)
async def reza_command(
    message: Message,
):
    user_id = (
        message.from_user.id
        if message.from_user
        else None
    )

    if not is_admin(user_id):
        await message.answer(
            "У вас нет прав администратора."
        )

        return

    # Если команда используется в группе,
    # автоматически регистрируем группу.
    if message.chat.type in (
        "group",
        "supergroup",
        "channel",
    ):
        save_announcement_chat(
            chat_id=message.chat.id,
            chat_type=message.chat.type,
            title=message.chat.title or "",
        )

    text = message.text or ""

    parts = text.split(
        maxsplit=1
    )

    if len(parts) < 2:
        await message.answer(
            "Использование:\n\n"
            "/reza Текст сообщения"
        )

        return

    reza_text = parts[1].strip()

    if not reza_text:
        await message.answer(
            "После /reza нужно написать текст."
        )

        return

    try:
        await message.bot.send_message(
            chat_id=message.chat.id,
            text=reza_text,
        )

        try:
            await message.delete()
        except Exception:
            pass

    except TelegramForbiddenError:
        await message.answer(
            "Бот не имеет права отправлять "
            "сообщения в этот чат."
        )

    except TelegramBadRequest as exc:
        logger.error(
            "/reza error: %s",
            exc,
        )

        await message.answer(
            "Не удалось отправить сообщение."
        )


