# ============================================================
# /RV
# ============================================================

@router.message(
    Command("rv")
)
async def cmd_rv(
    message: Message,
) -> None:

    if not is_admin(
        message.from_user.id
    ):

        await message.answer(
            "❌ У вас нет прав "
            "администратора."
        )

        return

    bookings = get_active_bookings()

    if not bookings:

        await message.answer(
            "📭 Активных бронирований нет."
        )

        return

    await message.answer(
        f"📋 ТЕКУЩИЕ РЕПЕТИЦИИ "
        f"({len(bookings)})"
    )

    for booking in bookings:

        status_label = (
            "⏳ Ожидает"
            if booking["status"]
            == "pending"
            else
            "✅ Подтверждено"
        )

        text = (
            f"📅 "
            f"{format_date_ru(booking['date'])}\n"

            f"⏰ "
            f"{booking['time_start']}"
            f"–"
            f"{booking['time_end']}\n"

            f"👤 "
            f"{booking['name']}\n"

            f"👥 "
            f"{booking['people_count']} человек\n"

            f"📞 "
            f"{booking['contact']}\n"

            f"🎭 "
            f"{booking['purpose']}\n\n"

            f"Статус: "
            f"{status_label}"
        )

        await message.answer(
            text,
            reply_markup=(
                delete_one_keyboard(
                    booking["id"]
                )
            ),
        )


# ============================================================
# /DELETE
# ============================================================

@router.message(
    Command("delete")
)
async def cmd_delete(
    message: Message,
    state: FSMContext,
) -> None:

    if not is_admin(
        message.from_user.id
    ):

        await message.answer(
            "❌ У вас нет прав "
            "администратора."
        )

        return

    active = get_active_bookings()

    if not active:

        await message.answer(
            "📭 Активных бронирований нет."
        )

        return

    await state.set_state(
        DeleteStates.confirming
    )

    await message.answer(
        "⚠️ ВНИМАНИЕ!\n\n"

        f"Будет отменено "
        f"бронирований: "
        f"{len(active)}.\n\n"

        "Вы уверены?",
        reply_markup=(
            delete_confirm_keyboard()
        ),
    )


# ============================================================
# ПОДТВЕРЖДЕНИЕ DELETE
# ============================================================

@router.callback_query(
    DeleteStates.confirming,
    F.data == "delete_confirm",
)
async def cb_delete_confirm(
    callback: CallbackQuery,
    state: FSMContext,
    bot: Bot,
) -> None:

    if not is_admin(
        callback.from_user.id
    ):

        await callback.answer(
            "❌ Нет прав.",
            show_alert=True,
        )

        return

    await callback.answer()

    await state.clear()

    removed = (
        clear_all_active_bookings()
    )

    for booking in removed:

        try:

            await bot.send_message(
                chat_id=booking["user_id"],
                text=(
                    "⚠️ ВНИМАНИЕ!\n\n"
                    "Ваше бронирование "
                    "было отменено "
                    "администратором."
                ),
            )

        except (
            TelegramBadRequest,
            TelegramForbiddenError,
        ):

            pass

    try:

        await callback.message.edit_text(
            f"✅ Удалено бронирований: "
            f"{len(removed)}."
        )

    except TelegramBadRequest:

        pass


# ============================================================
# ОТМЕНА DELETE
# ============================================================

@router.callback_query(
    DeleteStates.confirming,
    F.data == "delete_cancel",
)
async def cb_delete_cancel(
    callback: CallbackQuery,
    state: FSMContext,
) -> None:

    await callback.answer()

    await state.clear()

    try:

        await callback.message.edit_text(
            "Отменено. "
            "Бронирования не удалены."
        )

    except TelegramBadRequest:

        pass


