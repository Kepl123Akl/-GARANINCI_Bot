raise RuntimeError(
"Не найден токен бота. Установите переменную окружения BOT_TOKEN (или TOKEN) в BotHos
)
ADMIN_USER_ID = 8421476708
ADMIN_USERNAME = "VinnitSSki"
# Опционально: чат/канал для публикации подтверждённых репетиций.
# Если не задан — бот просто не публикует анонсы, но работает нормально.
ANNOUNCEMENT_CHAT_ID = os.getenv("ANNOUNCEMENT_CHAT_ID")
DB_FILE = "bookings.db"
TIMEZONE = ZoneInfo("Asia/Yekaterinburg")
DAYS_AHEAD = 30
WORK_START_HOUR = 8
WORK_END_HOUR = 20
MAX_PEOPLE = 24
WEEKDAYS_RU = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"]
# ============================================================
# БАЗА ДАННЫХ
# ============================================================
db_lock = asyncio.Lock()
def get_connection() -> sqlite3.Connection:
conn = sqlite3.connect(DB_FILE)
conn.row_factory = sqlite3.Row
return conn
def init_db() -> None:
conn = get_connection()
try:
conn.executescript(
"""
CREATE TABLE IF NOT EXISTS bookings (
id INTEGER PRIMARY KEY AUTOINCREMENT,
user_id INTEGER NOT NULL,
username TEXT,
name TEXT NOT NULL,
date TEXT NOT NULL,
time_start TEXT NOT NULL,
time_end TEXT NOT NULL,
people_count INTEGER NOT NULL,
contact TEXT NOT NULL,
purpose TEXT NOT NULL,
status TEXT NOT NULL DEFAULT 'pending',
created_at TEXT NOT NULL
);
CREATE UNIQUE INDEX IF NOT EXISTS idx_unique_active_slot
ON bookings(date, time_start)
WHERE status IN ('pending', 'approved');
"""
)
conn.commit()
finally:
conn.close()
def slot_bounds(hour: int) -> Tuple[str, str]:
return f"{hour:02d}:00", f"{hour + 1:02d}:00"
def get_busy_hours(date_str: str) -> Set[int]:
conn = get_connection()
try:
rows = conn.execute(
"SELECT time_start FROM bookings WHERE date = ? AND status IN ('pending','approve
(date_str,),
).fetchall()
return {int(row["time_start"].split(":")[0]) for row in rows}
finally:
conn.close()
def create_booking(
user_id: int,
username: Optional[str],
name: str,
date_str: str,
time_start: str,
time_end: str,
people_count: int,
contact: str,
purpose: str,
) -> int:
conn = get_connection()
try:
cur = conn.execute(
"""
INSERT INTO bookings
(user_id, username, name, date, time_start, time_end,
people_count, contact, purpose, status, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', ?)
""",
(
user_id,
username or "",
name,
date_str,
time_start,
time_end,
people_count,
contact,
purpose,
datetime.now(TIMEZONE).isoformat(timespec="seconds"),
),
)
conn.commit()
return int(cur.lastrowid)
finally:
conn.close()
def get_booking(booking_id: int) -> Optional[sqlite3.Row]:
conn = get_connection()
try:
return conn.execute(
"SELECT * FROM bookings WHERE id = ?", (booking_id,)
).fetchone()
finally:
conn.close()
def set_booking_status(booking_id: int, status: str) -> None:
conn = get_connection()
try:
conn.execute(
"UPDATE bookings SET status = ? WHERE id = ?", (status, booking_id)
)
conn.commit()
finally:
conn.close()
def get_active_bookings() -> List[sqlite3.Row]:
conn = get_connection()
try:
finally:
return conn.execute(
"""
SELECT * FROM bookings
WHERE status IN ('pending','approved')
ORDER BY date, time_start
"""
).fetchall()
conn.close()
def clear_all_active_bookings() -> List[sqlite3.Row]:
conn = get_connection()
try:
rows = conn.execute(
"SELECT * FROM bookings WHERE status IN ('pending','approved')"
).fetchall()
conn.execute(
"UPDATE bookings SET status = 'rejected' WHERE status IN ('pending','approved')"
)
conn.commit()
return rows
finally:
conn.close()
# ============================================================
# FSM СОСТОЯНИЯ
# ============================================================
class BookingStates(StatesGroup):
choosing_date = State()
choosing_time = State()
choosing_people = State()
entering_name = State()
entering_contact = State()
entering_purpose = State()
class DeleteStates(StatesGroup):
confirming = State()
# ============================================================
# КЛАВИАТУРЫ
# ============================================================
def main_menu_keyboard():
builder = InlineKeyboardBuilder()
builder.button(text=" Забронировать аудиторию", callback_data="book_start")
builder.adjust(1)
return builder.as_markup()
def date_keyboard():
builder = InlineKeyboardBuilder()
today = datetime.now(TIMEZONE).date()
for i in range(DAYS_AHEAD):
d = today + timedelta(days=i)
weekday = WEEKDAYS_RU[d.weekday()]
text = f"{d.strftime('%d.%m')} {weekday}"
builder.button(text=text, callback_data=f"date:{d.isoformat()}")
builder.adjust(3)
return builder.as_markup()
def time_keyboard(date_str: str):
busy_hours = get_busy_hours(date_str)
builder = InlineKeyboardBuilder()
has_free = False
for hour in range(WORK_START_HOUR, WORK_END_HOUR):
if hour in busy_hours:
continue
has_free = True
start, end = slot_bounds(hour)
builder.button(text=f"{start}–{end}", callback_data=f"time:{hour:02d}")
if not has_free:
return None
builder.adjust(3)
return builder.as_markup()
def people_keyboard():
builder = InlineKeyboardBuilder()
for n in range(1, MAX_PEOPLE + 1):
builder.button(text=str(n), callback_data=f"people:{n}")
builder.adjust(6)
return builder.as_markup()
def admin_decision_keyboard(booking_id: int):
builder = InlineKeyboardBuilder()
builder.button(text=" ПОДТВЕРДИТЬ", callback_data=f"approve:{booking_id}")
builder.button(text=" ОТКЛОНИТЬ", callback_data=f"reject:{booking_id}")
builder.adjust(2)
return builder.as_markup()
def delete_confirm_keyboard():
builder = InlineKeyboardBuilder()
builder.button(text=" Да, удалить всё", callback_data="delete_confirm")
builder.button(text=" Отмена", callback_data="delete_cancel")
builder.adjust(1)
return builder.as_markup()
def delete_one_keyboard(booking_id: int):
builder = InlineKeyboardBuilder()
builder.button(text=" Удалить эту запись", callback_data=f"delone:{booking_id}")
builder.adjust(1)
return builder.as_markup()
def delete_one_confirm_keyboard(booking_id: int):
builder = InlineKeyboardBuilder()
builder.button(text=" Да, удалить", callback_data=f"delone_yes:{booking_id}")
builder.button(text=" Отмена", callback_data=f"delone_no:{booking_id}")
builder.adjust(1)
return builder.as_markup()
