# НАЖАТИЕ "ЗАБРОНИРОВАТЬ"
# ============================================================

@router.callback_query(
    F.data == "book_start"
)
async def book_start_callback(
    callback: CallbackQuery,
    state: FSMContext,
):

    await callback.answer()

    await state.clear()

    await state.set_state(
        BookingStates.choosing_date
    )

    await callback.message.answer(
        "Выберите дату:",
        reply_markup=(
            date_keyboard()
        ),
    )


# ============================================================
# ДАТА
# ============================================================

@router.callback_query(
    BookingStates.choosing_date,
    F.data.startswith("date:"),
)
async def choose_date(
    callback: CallbackQuery,
    state: FSMContext,
):

    await callback.answer()

    date_str = callback.data.split(
        ":",
        1,
    )[1]

    keyboard = time_keyboard(
        date_str
    )

    if keyboard is None:

        await callback.message.answer(
            "На эту дату всё занято.\n\n"
            "Выберите другую дату:",
            reply_markup=(
                date_keyboard()
            ),
        )

        return

    await state.update_data(
        date=date_str
    )

    await state.set_state(
        BookingStates.choosing_time
    )

    await callback.message.answer(
        f"Дата: {format_date_ru(date_str)}\n\n"
        "Выберите время:",
        reply_markup=keyboard,
    )


# ============================================================
# ВРЕМЯ
# ============================================================

@router.callback_query(
    BookingStates.choosing_time,
    F.data.startswith("time:"),
)
async def choose_time(
    callback: CallbackQuery,
    state: FSMContext,
):

    data = await state.get_data()

    date_str = data.get(
        "date"
    )

    if not date_str:

        await callback.answer(
            "Сессия устарела.",
            show_alert=True,
        )

        await state.clear()

        return

    hour = int(
        callback.data.split(
            ":",
            1,
        )[1]
    )

    busy = get_busy_hours(
        date_str
    )

    if hour in busy:

        await callback.answer(
            "Это время уже занято.",
            show_alert=True,
        )

        return

    await callback.answer()

    start, end = slot_bounds(
        hour
    )

    await state.update_data(
        time_start=start,
        time_end=end,
    )

    await state.set_state(
        BookingStates.choosing_people
    )

    await callback.message.answer(
        f"Время: {start}–{end}\n\n"
        "Сколько будет человек?",
        reply_markup=(
            people_keyboard()
        ),
    )


# ============================================================
# ЛЮДИ
# ============================================================

@router.callback_query(
    BookingStates.choosing_people,
    F.data.startswith("people:"),
)
async def choose_people(
    callback: CallbackQuery,
    state: FSMContext,
):

    await callback.answer()

    people = int(
        callback.data.split(
            ":",
            1,
        )[1]
    )

    if people < 1 or people > MAX_PEOPLE:

        await callback.answer(
            "Недопустимое количество.",
            show_alert=True,
        )

        return

    await state.update_data(
        people_count=people
    )

    await state.set_state(
        BookingStates.entering_name
    )

    await callback.message.answer(
        "Введите ваше имя:"
    )


# ============================================================
# ИМЯ
