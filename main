# УДАЛЕНИЕ ОДНОЙ ЗАПИСИ
# ============================================================

@router.callback_query(
    F.data.startswith("delone:")
)
async def cb_delone_ask(
    callback: CallbackQuery,
) -> None:

    if not is_admin(
        callback.from_user.id
    ):

        await callback.answer(
            "❌ Нет прав.",
            show_alert=True,
        )

        return

    booking_id = int(
        callback.data.split(
            ":",
            1,
        )[1]
    )

    booking = get_booking(
        booking_id
    )

    if (
        booking is None
        or booking["status"]
        not in ("pending", "approved")
    ):

        await callback.answer(
            "Запись уже неактивна.",
            show_alert=True,
        )

        return

    await callback.answer()

    try:

        await callback.message.edit_reply_markup(
            reply_markup=(
                delete_one_confirm_keyboard(
                    booking_id
                )
            )
        )

    except TelegramBadRequest:

        pass


