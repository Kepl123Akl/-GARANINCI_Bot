@router.message(
    BookingStates.entering_name,
    F.text,
)
async def enter_name(
    message: Message,
    state: FSMContext,
):

    name = message.text.strip()

    if not name:

        await message.answer(
            "Введите имя."
        )

        return

    await state.update_data(
        name=name
    )

    await state.set_state(
        BookingStates.entering_contact
    )

    await message.answer(
        "Введите контактный номер "
        "или другой способ связи:"
    )


# ============================================================
# КОНТАКТ
# ============================================================

@router.message(
    BookingStates.entering_contact,
    F.text,
)
async def enter_contact(
    message: Message,
    state: FSMContext,
):

    contact = message.text.strip()

    if not contact:

        await message.answer(
            "Введите контакт."
        )

        return

    await state.update_data(
        contact=contact
    )

    await state.set_state(
        BookingStates.entering_purpose
    )

    await message.answer(
        "Для чего бронируете аудиторию?"
    )


# ============================================================
# ЦЕЛЬ + СОЗДАНИЕ ЗАЯВКИ
# ============================================================

@router.message(
    BookingStates.entering_purpose,
    F.text,
)
async def enter_purpose(
    message: Message,
    state: FSMContext,
):

    purpose = message.text.strip()

    if not purpose:

        await message.answer(
            "Введите цель бронирования."
        )

        return

    data = await state.get_data()

    date_str = data["date"]

    time_start = data["time_start"]

    time_end = data["time_end"]

    people_count = data["people_count"]

    name = data["name"]

    contact = data["contact"]

    # Проверяем ещё раз,
    # не заняли ли время.
    busy = get_busy_hours(
        date_str
    )

    hour = int(
        time_start.split(":")[0]
    )

    if hour in busy:

        await state.set_state(
            BookingStates.choosing_time
        )

        keyboard = time_keyboard(
            date_str
        )

        if keyboard:

            await message.answer(
                "Это время уже заняли.\n\n"
                "Выберите другое:",
                reply_markup=keyboard,
            )

        else:

            await state.set_state(
                BookingStates.choosing_date
            )

            await message.answer(
                "На эту дату больше "
                "нет свободного времени.",
                reply_markup=(
                    date_keyboard()
                ),
            )

        return

    try:

        booking_id = create_booking(
            user_id=message.from_user.id,
            username=message.from_user.username,
            name=name,
            date_str=date_str,
            time_start=time_start,
            time_end=time_end,
            people_count=people_count,
            contact=contact,
            purpose=purpose,
        )

    except sqlite3.IntegrityError:

        await message.answer(
            "Это время только что заняли. "
            "Попробуйте выбрать другое."
        )

        await state.set_state(
            BookingStates.choosing_time
        )

        keyboard = time_keyboard(
            date_str
        )

        if keyboard:

            await message.answer(
                "Свободное время:",
                reply_markup=keyboard,
            )

        return

    await state.clear()

    await message.answer(
        "Заявка отправлена администратору.\n\n"
        f"Дата: {format_date_ru(date_str)}\n"
        f"Время: {time_start}–{time_end}\n"
        f"Людей: {people_count}\n\n"
        "Ожидайте подтверждения."
    )

    username = (
        f"@{message.from_user.username}"
        if message.from_user.username
        else "нет username"
    )

    admin_text = (
        "НОВАЯ ЗАЯВКА\n\n"
        f"Заявка №{booking_id}\n\n"
        f"Дата: {format_date_ru(date_str)}\n"
        f"Время: {time_start}–{time_end}\n"
        f"Людей: {people_count}\n\n"
        f"Имя: {name}\n"
        f"Контакт: {contact}\n"
        f"Цель: {purpose}\n\n"
        f"Telegram: {username}\n"
        f"ID пользователя: {message.from_user.id}"
    )

    try:

        await message.bot.send_message(
            chat_id=ADMIN_USER_ID,
            text=admin_text,
            reply_markup=(
                admin_decision_keyboard(
                    booking_id
                )
            ),
        )

    except Exception as exc:

        logger.exception(
            "Не удалось отправить заявку админу: %s",
            exc,
        )


# ============================================================
# ПОДТВЕРЖДЕНИЕ
# ============================================================

@router.callback_query(
    F.data.startswith("approve:")
)
async def approve_booking(
    callback: CallbackQuery,
):

    if not is_admin(
        callback.from_user.id
    ):

        await callback.answer(
            "Нет прав.",
            show_alert=True,
        )

        return

    booking_id = int(
        callback.data.split(
            ":",
            1,
        )[1]
    )

    booking = get_booking(
        booking_id
    )

    if booking is None:

        await callback.answer(
            "Заявка не найдена.",
            show_alert=True,
        )

        return

    if booking["status"] != "pending":

        await callback.answer(
            "Заявка уже обработана.",
            show_alert=True,
        )

        return

    # Меняем статус
    set_booking_status(
        booking_id,
        "approved",
    )

    await callback.answer(
        "Подтверждено."
    )

    # Обновляем сообщение админу
    try:

        await callback.message.edit_text(
            callback.message.text
            + "\n\n"
            + "ПОДТВЕРЖДЕНО"
        )

    except TelegramBadRequest:
        pass

    # Уведомляем пользователя
    date_ru = format_date_ru(
        booking["date"]
    )

    try:

        await callback.bot.send_message(
            chat_id=booking["user_id"],
            text=(
                "РЕПЕТИЦИЯ ПОДТВЕРЖДЕНА\n\n"
                f"Дата: {date_ru}\n"
                f"Время: "
                f"{booking['time_start']}"
                f"–"
                f"{booking['time_end']}\n"
                f"Людей: "
                f"{booking['people_count']}"
            ),
        )

    except (
        TelegramBadRequest,
        TelegramForbiddenError,
    ) as exc:

        logger.warning(
            "Не удалось уведомить пользователя: %s",
            exc,
        )

    # ========================================================
    # ГЛАВНОЕ:
    # ПУБЛИКАЦИЯ ВО ВСЕ ЗАРЕГИСТРИРОВАННЫЕ ГРУППЫ
    # ========================================================

    announcement_text = (
        "РЕПЕТИЦИЯ СОСТОИТСЯ\n\n"
        f"Дата: {date_ru}\n"
        f"Время: "
        f"{booking['time_start']}"
        f"–"
        f"{booking['time_end']}\n"
        f"Количество: "
        f"{booking['people_count']} человек\n"
        f"Цель: "
        f"{booking['purpose']}\n\n"
        "Reza"
    )

    await send_announcement_to_all_chats(
        callback.bot,
        announcement_text,
    )


