import asyncio
import html
import logging
import os
import sqlite3
import uuid
from datetime import datetime, timedelta
from zoneinfo import ZoneInfo

from aiogram import Bot, Dispatcher, F, Router
from aiogram.client.default import DefaultBotProperties
from aiogram.enums import ParseMode
from aiogram.filters import Command, CommandStart
from aiogram.fsm.context import FSMContext
from aiogram.fsm.state import State, StatesGroup
from aiogram.types import (
    CallbackQuery,
    InlineKeyboardButton,
    InlineKeyboardMarkup,
    Message,
)
from aiogram.utils.keyboard import InlineKeyboardBuilder


# =========================================================
# НАСТРОЙКИ
# =========================================================

BOT_TOKEN = (
    os.getenv("BOT_TOKEN")
    or os.getenv("TOKEN")
    or os.getenv("API_TOKEN")
)

# ТВОЙ TELEGRAM ID
ADMIN_USER_ID = 8421476708

# Сюда позже можно поставить ID группы/канала.
# Например:
# ANNOUNCEMENT_CHAT_ID = -1001234567890
#
# Пока оставляем None.
ANNOUNCEMENT_CHAT_ID = None

# Часовой пояс
TIMEZONE_NAME = os.getenv(
    "TIMEZONE",
    "Asia/Yekaterinburg"
)

# Бронирование на 30 дней вперед
DATE_DAYS_AHEAD = 30

# База данных
DATABASE_PATH = "bookings.db"


if not BOT_TOKEN:
    raise RuntimeError(
        "Не найден BOT_TOKEN. "
        "Добавь BOT_TOKEN в переменные BotHost."
    )


TIMEZONE = ZoneInfo(TIMEZONE_NAME)


logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s"
)

logger = logging.getLogger(__name__)


# =========================================================
# БАЗА ДАННЫХ
# =========================================================

def get_db():
    conn = sqlite3.connect(
        DATABASE_PATH,
        timeout=30,
        check_same_thread=False
    )

    conn.row_factory = sqlite3.Row

    return conn


def init_db():
    conn = get_db()

    conn.execute("""
        CREATE TABLE IF NOT EXISTS bookings (
            id TEXT PRIMARY KEY,
            user_id INTEGER NOT NULL,
            username TEXT,
            name TEXT NOT NULL,
            booking_date TEXT NOT NULL,
            booking_time TEXT NOT NULL,
            people INTEGER NOT NULL,
            contact TEXT NOT NULL,
            purpose TEXT NOT NULL,
            status TEXT NOT NULL DEFAULT 'pending',
            created_at TEXT NOT NULL
        )
    """)

    # Нельзя создать две активные заявки
    # на одно и то же время.
    conn.execute("""
        CREATE UNIQUE INDEX IF NOT EXISTS active_slot_unique
        ON bookings(booking_date, booking_time)
        WHERE status IN ('pending', 'approved')
    """)

    conn.commit()
    conn.close()


def slot_is_busy(booking_date, booking_time):
    conn = get_db()

    row = conn.execute("""
        SELECT id
        FROM bookings
        WHERE booking_date = ?
          AND booking_time = ?
          AND status IN ('pending', 'approved')
        LIMIT 1
    """, (
        booking_date,
        booking_time
    )).fetchone()

    conn.close()

    return row is not None


def create_booking(
    user_id,
    username,
    name,
    booking_date,
    booking_time,
    people,
    contact,
    purpose
):
    booking_id = str(uuid.uuid4())

    conn = get_db()

    try:
        conn.execute("BEGIN IMMEDIATE")

        busy = conn.execute("""
            SELECT id
            FROM bookings
            WHERE booking_date = ?
              AND booking_time = ?
              AND status IN ('pending', 'approved')
            LIMIT 1
        """, (
            booking_date,
            booking_time
        )).fetchone()

        if busy:
            conn.rollback()
            return None

        conn.execute("""
            INSERT INTO bookings (
                id,
                user_id,
                username,
                name,
                booking_date,
                booking_time,
                people,
                contact,
                purpose,
                status,
                created_at
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', ?)
        """, (
            booking_id,
            user_id,
            username,
            name,
            booking_date,
            booking_time,
            people,
            contact,
            purpose,
            datetime.now(TIMEZONE).isoformat()
        ))

        conn.commit()

        return booking_id

    except Exception:
        conn.rollback()

        logger.exception(
            "Ошибка создания бронирования"
        )

        return None

    finally:
        conn.close()


def get_booking(booking_id):
    conn = get_db()

    row = conn.execute("""
        SELECT *
        FROM bookings
        WHERE id = ?
    """, (
        booking_id,
    )).fetchone()

    conn.close()

    return row


def update_booking_status(
    booking_id,
    status
):
    conn = get_db()

    conn.execute("""
        UPDATE bookings
        SET status = ?
        WHERE id = ?
    """, (
        status,
        booking_id
    ))

    conn.commit()
    conn.close()


def get_all_active_bookings():
    conn = get_db()

    rows = conn.execute("""
        SELECT *
        FROM bookings
        WHERE status IN ('pending', 'approved')
        ORDER BY booking_date, booking_time
    """).fetchall()

    conn.close()

    return rows


def delete_all_active_bookings():
    conn = get_db()

    rows = conn.execute("""
        SELECT *
        FROM bookings
        WHERE status IN ('pending', 'approved')
    """).fetchall()

    conn.execute("""
        DELETE FROM bookings
        WHERE status IN ('pending', 'approved')
    """)

    conn.commit()
    conn.close()

    return rows


# =========================================================
# КЛАВИАТУРЫ
# =========================================================

def date_keyboard():

    builder = InlineKeyboardBuilder()

    today = datetime.now(TIMEZONE).date()

    for i in range(DATE_DAYS_AHEAD):

        current_date = (
            today + timedelta(days=i)
        )

        builder.button(
            text=current_date.strftime(
                "%d.%m.%Y"
            ),
            callback_data=(
                f"date:{current_date.isoformat()}"
            )
        )

    builder.adjust(2)

    return builder.as_markup()


def time_keyboard(booking_date):

    builder = InlineKeyboardBuilder()

    # Слоты:
    # 08:00–09:00
    # 09:00–10:00
    # ...
    # 19:00–20:00

    for hour in range(8, 20):

        booking_time = (
            f"{hour:02d}:00"
        )

        if not slot_is_busy(
            booking_date,
            booking_time
        ):

            builder.button(
                text=booking_time,
                callback_data=(
                    f"time:{booking_time}"
                )
            )

    builder.adjust(3)

    return builder.as_markup()


def people_keyboard():

    builder = InlineKeyboardBuilder()

    for people in range(1, 11):

        builder.button(
            text=str(people),
            callback_data=(
                f"people:{people}"
            )
        )

    builder.adjust(5)

    return builder.as_markup()


def admin_keyboard(booking_id):

    return InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(
                    text="✅ Одобрить",
                    callback_data=(
                        f"approve:{booking_id}"
                    )
                ),
                InlineKeyboardButton(
                    text="❌ Отклонить",
                    callback_data=(
                        f"reject:{booking_id}"
                    )
                )
            ]
        ]
    )


# =========================================================
# СОСТОЯНИЯ
# =========================================================

class BookingStates(StatesGroup):

    selecting_date = State()

    selecting_time = State()

    selecting_people = State()

    entering_name = State()

    entering_contact = State()

    entering_purpose = State()


ROUTER = Router()


# =========================================================
# ФОРМАТ ЗАЯВКИ
# =========================================================

def booking_text(booking):

    username = (
        f"@{html.escape(booking['username'])}"
        if booking["username"]
        else "не указан"
    )

    return (
        "<b>🎭 НОВАЯ ЗАЯВКА</b>\n\n"

        f"📅 <b>Дата:</b> "
        f"{html.escape(booking['booking_date'])}\n"

        f"⏰ <b>Время:</b> "
        f"{html.escape(booking['booking_time'])}\n"

        f"👥 <b>Людей:</b> "
        f"{booking['people']}\n"

        f"👤 <b>Имя:</b> "
        f"{html.escape(booking['name'])}\n"

        f"📞 <b>Контакт:</b> "
        f"{html.escape(booking['contact'])}\n"

        f"🎯 <b>Цель:</b> "
        f"{html.escape(booking['purpose'])}\n"

        f"💬 <b>Telegram:</b> "
        f"{username}"
    )


# =========================================================
# ПУБЛИКАЦИЯ РЕПЕТИЦИИ
# =========================================================

async def publish_rehearsal(
    bot,
    booking
):

    if not ANNOUNCEMENT_CHAT_ID:

        logger.info(
            "ANNOUNCEMENT_CHAT_ID не указан. "
            "Публикация пропущена."
        )

        return

    start_hour = int(
        booking["booking_time"][:2]
    )

    end_hour = start_hour + 1

    start_time = booking["booking_time"]

    end_time = (
        f"{end_hour:02d}:00"
    )

    text = (
        "📢 <b>РЕПЕТИЦИЯ СОСТОИТСЯ</b>\n\n"

        f"📅 <b>Дата:</b> "
        f"{html.escape(booking['booking_date'])}\n"

        f"⏰ <b>Время:</b> "
        f"{start_time}–{end_time}\n"

        f"👥 <b>Количество:</b> "
        f"{booking['people']} чел.\n"

        f"🎭 <b>Цель:</b> "
        f"{html.escape(booking['purpose'])}"
    )

    try:

        await bot.send_message(
            chat_id=ANNOUNCEMENT_CHAT_ID,
            text=text
        )

        logger.info(
            "Репетиция опубликована."
        )

    except Exception:

        logger.exception(
            "Ошибка публикации "
            "репетиции."
        )


# =========================================================
# START
# =========================================================

@ROUTER.message(CommandStart())
async def start(
    message: Message,
    state: FSMContext
):

    await state.clear()

    await state.set_state(
        BookingStates.selecting_date
    )

    await message.answer(
        "🎭 <b>Гаранинцы</b>\n\n"
        "📅 Выберите дату репетиции:",
        reply_markup=date_keyboard()
    )


# =========================================================
# BOOK
# =========================================================

@ROUTER.message(Command("book"))
async def book_command(
    message: Message,
    state: FSMContext
):

    await state.clear()

    await state.set_state(
        BookingStates.selecting_date
    )

    await message.answer(
        "📅 Выберите дату:",
        reply_markup=date_keyboard()
    )


# =========================================================
# ВЫБОР ДАТЫ
# =========================================================

@ROUTER.callback_query(
    F.data.startswith("date:")
)
async def select_date(
    callback: CallbackQuery,
    state: FSMContext
):

    booking_date = callback.data.split(
        ":",
        1
    )[1]

    await state.update_data(
        booking_date=booking_date
    )

    await state.set_state(
        BookingStates.selecting_time
    )

    await callback.message.edit_text(
        f"📅 <b>{booking_date}</b>\n\n"
        "⏰ Выберите свободное время:",
        reply_markup=time_keyboard(
            booking_date
        )
    )

    await callback.answer()


# =========================================================
# ВЫБОР ВРЕМЕНИ
# =========================================================

@ROUTER.callback_query(
    F.data.startswith("time:")
)
async def select_time(
    callback: CallbackQuery,
    state: FSMContext
):

    data = await state.get_data()

    booking_date = data.get(
        "booking_date"
    )

    if not booking_date:

        await callback.answer(
            "Сначала выберите дату.",
            show_alert=True
        )

        return

    booking_time = callback.data.split(
        ":",
        1
    )[1]

    if slot_is_busy(
        booking_date,
        booking_time
    ):

        await callback.answer(
            "Это время уже занято.",
            show_alert=True
        )

        await callback.message.edit_reply_markup(
            reply_markup=time_keyboard(
                booking_date
            )
        )

        return

    await state.update_data(
        booking_time=booking_time
    )

    await state.set_state(
        BookingStates.selecting_people
    )

    await callback.message.edit_text(
        f"📅 {booking_date}\n"
        f"⏰ {booking_time}\n\n"
        "👥 Сколько будет человек?",
        reply_markup=people_keyboard()
    )

    await callback.answer()


# =========================================================
# ЛЮДИ
# =========================================================

@ROUTER.callback_query(
    F.data.startswith("people:")
)
async def select_people(
    callback: CallbackQuery,
    state: FSMContext
):

    people = int(
        callback.data.split(
            ":",
            1
        )[1]
    )

    await state.update_data(
        people=people
    )

    await state.set_state(
        BookingStates.entering_name
    )

    await callback.message.edit_text(
        "👤 Введите ваше имя:"
    )

    await callback.answer()


# =========================================================
# ИМЯ
# =========================================================

@ROUTER.message(
    BookingStates.entering_name
)
async def enter_name(
    message: Message,
    state: FSMContext
):

    name = (
        message.text or ""
    ).strip()

    if len(name) < 2:

        await message.answer(
            "Введите имя."
        )

        return

    await state.update_data(
        name=name
    )

    await state.set_state(
        BookingStates.entering_contact
    )

    await message.answer(
        "📞 Введите номер телефона "
        "или другой контакт:"
    )


# =========================================================
# КОНТАКТ
# =========================================================

@ROUTER.message(
    BookingStates.entering_contact
)
async def enter_contact(
    message: Message,
    state: FSMContext
):

    contact = (
        message.text or ""
    ).strip()

    if len(contact) < 3:

        await message.answer(
            "Введите корректный контакт."
        )

        return

    await state.update_data(
        contact=contact
    )

    await state.set_state(
        BookingStates.entering_purpose
    )

    await message.answer(
        "🎭 Для чего бронируете аудиторию?"
    )


# =========================================================
# СОЗДАНИЕ ЗАЯВКИ
# =========================================================

@ROUTER.message(
    BookingStates.entering_purpose
)
async def enter_purpose(
    message: Message,
    state: FSMContext,
    bot: Bot
):

    purpose = (
        message.text or ""
    ).strip()

    if len(purpose) < 2:

        await message.answer(
            "Напишите цель бронирования."
        )

        return

    data = await state.get_data()

    booking_id = create_booking(
        user_id=message.from_user.id,
        username=message.from_user.username,
        name=data["name"],
        booking_date=data["booking_date"],
        booking_time=data["booking_time"],
        people=data["people"],
        contact=data["contact"],
        purpose=purpose
    )

    if not booking_id:

        await message.answer(
            "❌ Это время уже заняли.\n\n"
            "Используйте /book "
            "и выберите другое время."
        )

        await state.clear()

        return

    booking = get_booking(
        booking_id
    )

    await state.clear()

    await message.answer(
        "✅ <b>Заявка отправлена!</b>\n\n"

        f"📅 {booking['booking_date']}\n"
        f"⏰ {booking['booking_time']}\n"
        f"👥 {booking['people']} человек\n\n"

        "Ожидайте подтверждения."
    )

    # =====================================================
    # ОТПРАВЛЯЕМ ЗАЯВКУ ТЕБЕ
    # =====================================================

    try:

        await bot.send_message(
            chat_id=ADMIN_USER_ID,
            text=booking_text(
                booking
            ),
            reply_markup=admin_keyboard(
                booking_id
            )
        )

        logger.info(
            "Заявка отправлена администратору."
        )

    except Exception:

        logger.exception(
            "НЕ УДАЛОСЬ отправить заявку "
            "администратору."
        )


# =========================================================
# ОДОБРИТЬ
# =========================================================

@ROUTER.callback_query(
    F.data.startswith("approve:")
)
async def approve_booking(
    callback: CallbackQuery,
    bot: Bot
):

    if callback.from_user.id != ADMIN_USER_ID:

        await callback.answer(
            "У вас нет прав администратора.",
            show_alert=True
        )

        return

    booking_id = callback.data.split(
        ":",
        1
    )[1]

    booking = get_booking(
        booking_id
    )

    if not booking:

        await callback.answer(
            "Заявка не найдена.",
            show_alert=True
        )

        return

    if booking["status"] != "pending":

        await callback.answer(
            "Заявка уже обработана.",
            show_alert=True
        )

        return

    update_booking_status(
        booking_id,
        "approved"
    )

    booking = get_booking(
        booking_id
    )

    start_hour = int(
        booking["booking_time"][:2]
    )

    end_time = (
        f"{start_hour + 1:02d}:00"
    )

    # Сообщение пользователю
    try:

        await bot.send_message(
            chat_id=booking["user_id"],
            text=(
                "✅ <b>РЕПЕТИЦИЯ ПОДТВЕРЖДЕНА!</b>\n\n"

                f"📅 <b>Дата:</b> "
                f"{booking['booking_date']}\n"

                f"⏰ <b>Время:</b> "
                f"{booking['booking_time']}–"
                f"{end_time}\n"

                f"👥 <b>Людей:</b> "
                f"{booking['people']}"
            )
        )

    except Exception:

        logger.exception(
            "Не удалось уведомить пользователя."
        )

    # Пишем в группу/канал
    await publish_rehearsal(
        bot,
        booking
    )

    await callback.message.edit_text(
        booking_text(
            booking
        )
        +
        "\n\n"
        "✅ <b>ОДОБРЕНО</b>"
    )

    await callback.answer(
        "Репетиция подтверждена."
    )


# =========================================================
# ОТКЛОНИТЬ
# =========================================================

@ROUTER.callback_query(
    F.data.startswith("reject:")
)
async def reject_booking(
    callback: CallbackQuery,
    bot: Bot
):

    if callback.from_user.id != ADMIN_USER_ID:

        await callback.answer(
            "У вас нет прав администратора.",
            show_alert=True
        )

        return

    booking_id = callback.data.split(
        ":",
        1
    )[1]

    booking = get_booking(
        booking_id
    )

    if not booking:

        await callback.answer(
            "Заявка не найдена.",
            show_alert=True
        )

        return

    if booking["status"] != "pending":

        await callback.answer(
            "Заявка уже обработана.",
            show_alert=True
        )

        return

    update_booking_status(
        booking_id,
        "rejected"
    )

    try:

        await bot.send_message(
            chat_id=booking["user_id"],
            text=(
                "❌ <b>Репетиция отклонена.</b>\n\n"

                f"📅 {booking['booking_date']}\n"
                f"⏰ {booking['booking_time']}"
            )
        )

    except Exception:

        logger.exception(
            "Не удалось уведомить пользователя."
        )

    await callback.message.edit_text(
        booking_text(
            get_booking(booking_id)
        )
        +
        "\n\n"
        "❌ <b>ОТКЛОНЕНО</b>"
    )

    await callback.answer(
        "Заявка отклонена."
    )


# =========================================================
# /RV
# =========================================================

@ROUTER.message(Command("rv"))
async def rv_command(
    message: Message
):

    if message.from_user.id != ADMIN_USER_ID:

        await message.answer(
            "❌ У вас нет прав."
        )

        return

    bookings = get_all_active_bookings()

    if not bookings:

        await message.answer(
            "📭 Активных бронирований нет."
        )

        return

    lines = [
        "📋 <b>ТЕКУЩИЕ РЕПЕТИЦИИ</b>\n"
    ]

    for booking in bookings:

        hour = int(
            booking["booking_time"][:2]
        )

        end_time = (
            f"{hour + 1:02d}:00"
        )

        lines.append(
            f"📅 {booking['booking_date']} "
            f"⏰ {booking['booking_time']}–{end_time} "
            f"— {html.escape(booking['name'])} "
            f"— {booking['people']} чел."
        )

    await message.answer(
        "\n".join(lines)
    )


# =========================================================
# /DELETE
# =========================================================

@ROUTER.message(Command("delete"))
async def delete_command(
    message: Message,
    bot: Bot
):

    if message.from_user.id != ADMIN_USER_ID:

        await message.answer(
            "❌ У вас нет прав."
        )

        return

    bookings = delete_all_active_bookings()

    if not bookings:

        await message.answer(
            "📭 Активных бронирований нет."
        )

        return

    user_ids = set(
        booking["user_id"]
        for booking in bookings
    )

    for user_id in user_ids:

        try:

            await bot.send_message(
                chat_id=user_id,
                text=(
                    "⚠️ <b>Внимание</b>\n\n"
                    "Все активные бронирования "
                    "были отменены администратором."
                )
            )

        except Exception:

            logger.warning(
                "Не удалось уведомить %s",
                user_id
            )

    await message.answer(
        f"✅ Удалено бронирований: "
        f"<b>{len(bookings)}</b>"
    )


# =========================================================
# /CANCEL
# =========================================================

@ROUTER.message(Command("cancel"))
async def cancel_command(
    message: Message,
    state: FSMContext
):

    await state.clear()

    await message.answer(
        "❌ Бронирование отменено."
    )


# =========================================================
# ЗАПУСК БОТА
# =========================================================

async def main():

    init_db()

    bot = Bot(
        token=BOT_TOKEN,
        default=DefaultBotProperties(
            parse_mode=ParseMode.HTML
        )
    )

    dp = Dispatcher()

    dp.include_router(
        ROUTER
    )

    logger.info(
        "================================"
    )

    logger.info(
        "Бот запущен."
    )

    logger.info(
        "Администратор: %s",
        ADMIN_USER_ID
    )

    logger.info(
        "================================"
    )

    try:

        await dp.start_polling(
            bot
        )

    finally:

        await bot.session.close()


if __name__ == "__main__":
    asyncio.run(main())
