import asyncio
import logging
import os
import sqlite3
from datetime import datetime, timedelta
from typing import Optional
from zoneinfo import ZoneInfo

from aiogram import Bot, Dispatcher, F, Router
from aiogram.exceptions import TelegramBadRequest, TelegramForbiddenError
from aiogram.filters import Command, CommandStart
from aiogram.fsm.context import FSMContext
from aiogram.fsm.state import State, StatesGroup
from aiogram.fsm.storage.memory import MemoryStorage
from aiogram.types import CallbackQuery, ChatMemberUpdated, Message
from aiogram.utils.keyboard import InlineKeyboardBuilder


# ============================================================
# НАСТРОЙКИ
# ============================================================

BOT_TOKEN = os.getenv("BOT_TOKEN") or os.getenv("TOKEN")

if not BOT_TOKEN:
    raise RuntimeError(
        "Не найден BOT_TOKEN. Добавьте токен бота в переменные BotHost."
    )

ADMIN_USER_ID = 8421476708

DB_FILE = "bookings.db"

TIMEZONE = ZoneInfo("Asia/Yekaterinburg")

DAYS_AHEAD = 30

WORK_START_HOUR = 8
WORK_END_HOUR = 20

MAX_PEOPLE = 24

WEEKDAYS_RU = [
    "Пн",
    "Вт",
    "Ср",
    "Чт",
    "Пт",
    "Сб",
    "Вс",
]


# ============================================================
# LOGGING
# ============================================================

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s",
)

logger = logging.getLogger("GARANINCI")


# ============================================================
# DATABASE
# ============================================================

def get_connection():
    conn = sqlite3.connect(
        DB_FILE,
        timeout=30,
    )
    conn.row_factory = sqlite3.Row
    return conn


def init_db():
    conn = get_connection()

    try:
        conn.executescript(
            """
            CREATE TABLE IF NOT EXISTS bookings (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER NOT NULL,
                username TEXT,
                name TEXT NOT NULL,
                date TEXT NOT NULL,
                time_start TEXT NOT NULL,
                time_end TEXT NOT NULL,
                people_count INTEGER NOT NULL,
                contact TEXT NOT NULL,
                purpose TEXT NOT NULL,
                status TEXT NOT NULL DEFAULT 'pending',
                created_at TEXT NOT NULL
            );

            CREATE UNIQUE INDEX IF NOT EXISTS
            idx_unique_active_slot
            ON bookings(date, time_start)
            WHERE status IN ('pending', 'approved');


            CREATE TABLE IF NOT EXISTS announcement_chats (
                chat_id INTEGER PRIMARY KEY,
                chat_type TEXT NOT NULL,
                title TEXT,
                created_at TEXT NOT NULL
            );
            """
        )

        conn.commit()

    finally:
        conn.close()


# ============================================================
# ГРУППЫ ДЛЯ АВТОМАТИЧЕСКОЙ ПУБЛИКАЦИИ
# ============================================================

def save_announcement_chat(
    chat_id: int,
    chat_type: str,
    title: str,
):
    conn = get_connection()

    try:
        conn.execute(
            """
            INSERT OR REPLACE INTO announcement_chats
            (
                chat_id,
                chat_type,
                title,
                created_at
            )
            VALUES (?, ?, ?, ?)
            """,
            (
                chat_id,
                chat_type,
                title or "",
                datetime.now(
                    TIMEZONE
                ).isoformat(
                    timespec="seconds"
                ),
            ),
        )

        conn.commit()

    finally:
        conn.close()

    logger.info(
        "Группа сохранена: %s | %s | %s",
        chat_id,
        chat_type,
        title,
    )


def remove_announcement_chat(
    chat_id: int,
):
    conn = get_connection()

    try:
        conn.execute(
            """
            DELETE FROM announcement_chats
            WHERE chat_id = ?
            """,
            (chat_id,),
        )

        conn.commit()

    finally:
        conn.close()

    logger.info(
        "Группа удалена: %s",
        chat_id,
    )


def get_announcement_chats():
    conn = get_connection()

    try:
        return conn.execute(
            """
            SELECT *
            FROM announcement_chats
            ORDER BY title
            """
        ).fetchall()

    finally:
        conn.close()


# ============================================================
# АВТОМАТИЧЕСКОЕ ОТСЛЕЖИВАНИЕ ГРУПП
# ============================================================

router = Router()


@router.my_chat_member()
async def bot_chat_member_update(
    event: ChatMemberUpdated,
):
    chat = event.chat

    new_status = event.new_chat_member.status

    logger.info(
        "Изменение статуса бота: chat=%s type=%s status=%s",
        chat.id,
        chat.type,
        new_status,
    )

    # Бот добавлен / имеет права
    if new_status in (
        "member",
        "administrator",
    ):
        if chat.type in (
            "group",
            "supergroup",
            "channel",
        ):
            save_announcement_chat(
                chat_id=chat.id,
                chat_type=chat.type,
                title=chat.title or "",
            )

    # Бот удалён
    elif new_status in (
        "left",
        "kicked",
    ):
        remove_announcement_chat(
            chat.id
        )


# ============================================================
# ОТПРАВКА ВО ВСЕ ГРУППЫ
# ============================================================

async def send_announcement_to_all_chats(
    bot: Bot,
    text: str,
):
    chats = get_announcement_chats()

    if not chats:
        logger.warning(
            "Нет зарегистрированных групп для публикации."
        )
        return

    logger.info(
        "Начинаем рассылку в %s чатов.",
        len(chats),
    )

    for chat in chats:

        chat_id = chat["chat_id"]

        try:

            await bot.send_message(
                chat_id=chat_id,
                text=text,
            )

            logger.info(
                "Анонс успешно отправлен в %s",
                chat_id,
            )

        except TelegramForbiddenError:

            logger.warning(
                "Нет прав на отправку в %s. Удаляем чат.",
                chat_id,
            )

            remove_announcement_chat(
                chat_id
            )

        except TelegramBadRequest as exc:

            logger.error(
                "Telegram ошибка в чате %s: %s",
                chat_id,
                exc,
            )

        except Exception as exc:

            logger.exception(
                "Ошибка отправки в %s: %s",
                chat_id,
                exc,
            )

        # Небольшая пауза между чатами
        await asyncio.sleep(0.3)


# ============================================================
# FSM
# ============================================================

class BookingStates(StatesGroup):
    choosing_date = State()
    choosing_time = State()
    choosing_people = State()
    entering_name = State()
    entering_contact = State()
    entering_purpose = State()


class DeleteStates(StatesGroup):
    confirming = State()


# ============================================================
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ============================================================

def is_admin(user_id: int) -> bool:
    return user_id == ADMIN_USER_ID


def format_date_ru(
    date_str: str,
) -> str:

    date = datetime.strptime(
        date_str,
        "%Y-%m-%d",
    ).date()

    return date.strftime(
        "%d.%m.%Y"
    )


def slot_bounds(
    hour: int,
):
    return (
        f"{hour:02d}:00",
        f"{hour + 1:02d}:00",
    )


# ============================================================
# КЛАВИАТУРЫ
# ============================================================

def main_menu_keyboard():

    builder = InlineKeyboardBuilder()

    builder.button(
        text="Забронировать аудиторию",
        callback_data="book_start",
    )

    builder.adjust(1)

    return builder.as_markup()


def date_keyboard():

    builder = InlineKeyboardBuilder()

    today = datetime.now(
        TIMEZONE
    ).date()

    for i in range(
        DAYS_AHEAD
    ):

        date = today + timedelta(
            days=i
        )

        weekday = WEEKDAYS_RU[
            date.weekday()
        ]

        builder.button(
            text=(
                f"{date.strftime('%d.%m')} "
                f"{weekday}"
            ),
            callback_data=(
                f"date:{date.isoformat()}"
            ),
        )

    builder.adjust(3)

    return builder.as_markup()


def get_busy_hours(
    date_str: str,
):

    conn = get_connection()

    try:

        rows = conn.execute(
            """
            SELECT time_start
            FROM bookings
            WHERE date = ?
            AND status IN ('pending', 'approved')
            """,
            (date_str,),
        ).fetchall()

        return {
            int(
                row["time_start"]
                .split(":")[0]
            )
            for row in rows
        }

    finally:
        conn.close()


def time_keyboard(
    date_str: str,
):

    busy = get_busy_hours(
        date_str
    )

    builder = InlineKeyboardBuilder()

    free_count = 0

    for hour in range(
        WORK_START_HOUR,
        WORK_END_HOUR,
    ):

        if hour in busy:
            continue

        start, end = slot_bounds(
            hour
        )

        builder.button(
            text=f"{start}–{end}",
            callback_data=(
                f"time:{hour}"
            ),
        )

        free_count += 1

    if free_count == 0:
        return None

    builder.adjust(3)

    return builder.as_markup()


def people_keyboard():

    builder = InlineKeyboardBuilder()

    for people in range(
        1,
        MAX_PEOPLE + 1,
    ):

        builder.button(
            text=str(people),
            callback_data=(
                f"people:{people}"
            ),
        )

    builder.adjust(6)

    return builder.as_markup()


def admin_decision_keyboard(
    booking_id: int,
):

    builder = InlineKeyboardBuilder()

    builder.button(
        text="ПОДТВЕРДИТЬ",
        callback_data=(
            f"approve:{booking_id}"
        ),
    )

    builder.button(
        text="ОТКЛОНИТЬ",
        callback_data=(
            f"reject:{booking_id}"
        ),
    )

    builder.adjust(2)

    return builder.as_markup()


def delete_confirm_keyboard():

    builder = InlineKeyboardBuilder()

    builder.button(
        text="Да, удалить всё",
        callback_data="delete_confirm",
    )

    builder.button(
        text="Отмена",
        callback_data="delete_cancel",
    )

    builder.adjust(1)

    return builder.as_markup()


# ============================================================
# БРОНИРОВАНИЯ
# ============================================================

def create_booking(
    user_id: int,
    username: Optional[str],
    name: str,
    date_str: str,
    time_start: str,
    time_end: str,
    people_count: int,
    contact: str,
    purpose: str,
):

    conn = get_connection()

    try:

        cursor = conn.execute(
            """
            INSERT INTO bookings
            (
                user_id,
                username,
                name,
                date,
                time_start,
                time_end,
                people_count,
                contact,
                purpose,
                status,
                created_at
            )
            VALUES
            (
                ?, ?, ?, ?, ?, ?,
                ?, ?, ?, 'pending', ?
            )
            """,
            (
                user_id,
                username or "",
                name,
                date_str,
                time_start,
                time_end,
                people_count,
                contact,
                purpose,
                datetime.now(
                    TIMEZONE
                ).isoformat(
                    timespec="seconds"
                ),
            ),
        )

        conn.commit()

        return cursor.lastrowid

    finally:
        conn.close()


def get_booking(
    booking_id: int,
):

    conn = get_connection()

    try:

        return conn.execute(
            """
            SELECT *
            FROM bookings
            WHERE id = ?
            """,
            (booking_id,),
        ).fetchone()

    finally:
        conn.close()


def set_booking_status(
    booking_id: int,
    status: str,
):

    conn = get_connection()

    try:

        conn.execute(
            """
            UPDATE bookings
            SET status = ?
            WHERE id = ?
            """,
            (
                status,
                booking_id,
            ),
        )

        conn.commit()

    finally:
        conn.close()


def get_active_bookings():

    conn = get_connection()

    try:

        return conn.execute(
            """
            SELECT *
            FROM bookings
            WHERE status IN ('pending', 'approved')
            ORDER BY date, time_start
            """
        ).fetchall()

    finally:
        conn.close()


def clear_all_active_bookings():

    conn = get_connection()

    try:

        rows = conn.execute(
            """
            SELECT *
            FROM bookings
            WHERE status IN ('pending', 'approved')
            """
        ).fetchall()

        conn.execute(
            """
            UPDATE bookings
            SET status = 'rejected'
            WHERE status IN ('pending', 'approved')
            """
        )

        conn.commit()

        return rows

    finally:
        conn.close()


# ============================================================
# START
# ============================================================

@router.message(
    CommandStart()
)
async def start_command(
    message: Message,
    state: FSMContext,
):

    await state.clear()

    # Если бот находится в группе,
    # автоматически регистрируем её.
    if message.chat.type in (
        "group",
        "supergroup",
        "channel",
    ):

        save_announcement_chat(
            chat_id=message.chat.id,
            chat_type=message.chat.type,
            title=message.chat.title or "",
        )

    await message.answer(
        "ГАРАНИНЦЫ\n\n"
        "Добро пожаловать!\n\n"
        "Выберите действие:",
        reply_markup=(
            main_menu_keyboard()
        ),
    )


# ============================================================
# /REZA
# ============================================================

@router.message(
    Command("reza")
)
async def reza_command(
    message: Message,
):

    if not is_admin(
        message.from_user.id
    ):

        await message.answer(
            "У вас нет прав администратора."
        )

        return

    # Если /reza используется в группе,
    # гарантированно сохраняем эту группу.
    if message.chat.type in (
        "group",
        "supergroup",
        "channel",
    ):

        save_announcement_chat(
            chat_id=message.chat.id,
            chat_type=message.chat.type,
            title=message.chat.title or "",
        )

    text = message.text or ""

    parts = text.split(
        maxsplit=1
    )

    if len(parts) < 2:

        await message.answer(
            "Использование:\n\n"
            "/reza Текст сообщения"
        )

        return

    reza_text = parts[1].strip()

    if not reza_text:

        await message.answer(
            "После /reza нужно написать текст."
        )

        return

    try:

        await message.bot.send_message(
            chat_id=message.chat.id,
            text=reza_text,
        )

        # Удаляем команду
        try:
            await message.delete()
        except Exception:
            pass

    except TelegramForbiddenError:

        await message.answer(
            "Бот не имеет права отправлять "
            "сообщения в этот чат."
        )

    except TelegramBadRequest as exc:

        logger.error(
            "/reza error: %s",
            exc,
        )

        await message.answer(
            "Не удалось отправить сообщение."
        )


# ============================================================
# /BOOK
# ============================================================

@router.message(
    Command("book")
)
async def book_command(
    message: Message,
    state: FSMContext,
):

    await state.clear()

    await state.set_state(
        BookingStates.choosing_date
    )

    await message.answer(
        "Выберите дату:",
        reply_markup=(
            date_keyboard()
        ),
    )


