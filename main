"""
Telegram-бот для бронирования театральной аудитории «Гаранинцы».
Стек: Python 3, aiogram 3.x, SQLite, asyncio.
Рассчитан на запуск на BotHost командой: python main.py
"""
import asyncio
import logging
import os
import sqlite3
from datetime import date, datetime, timedelta
from zoneinfo import ZoneInfo
from aiogram import Bot, Dispatcher, F, Router
from aiogram.client.default import DefaultBotProperties
from aiogram.enums import ParseMode
from aiogram.exceptions import TelegramBadRequest, TelegramForbiddenError
from aiogram.filters import Command, CommandStart
from aiogram.filters.callback_data import CallbackData
from aiogram.fsm.context import FSMContext
from aiogram.fsm.state import State, StatesGroup
from aiogram.fsm.storage.memory import MemoryStorage
from aiogram.types import CallbackQuery, Message
from aiogram.utils.keyboard import InlineKeyboardBuilder
# ======================================================================
# КОНФИГУРАЦИЯ
# ======================================================================
logging.basicConfig(
level=logging.INFO,
format="%(asctime)s | %(levelname)s | %(name)s | %(message)s",
)
logger = logging.getLogger("garaninsty_bot")
BOT_TOKEN = os.getenv("BOT_TOKEN") or os.getenv("TOKEN")
if not BOT_TOKEN:
raise RuntimeError(
"Не найден токен бота. Задайте переменную окружения BOT_TOKEN "
"(или TOKEN) в настройках BotHost."
)
# Главный администратор — определён прямо в коде, отдельная переменная
# ADMIN_CHAT_ID в BotHost не требуется.
ADMIN_USER_ID = 8421476708
ADMIN_USERNAME = "VinnitSSki"
# Необязательная настройка — публикация подтверждённых репетиций
# в группу/канал. Если не задана, бот работает и без неё.
_raw_announcement_chat_id = os.getenv("ANNOUNCEMENT_CHAT_ID")
ANNOUNCEMENT_CHAT_ID: int | None = None
if _raw_announcement_chat_id:
try:
ANNOUNCEMENT_CHAT_ID = int(_raw_announcement_chat_id)
except ValueError:
logger.warning(
"ANNOUNCEMENT_CHAT_ID указан некорректно (%s), публикация отключена.",
_raw_announcement_chat_id,
)
TIMEZONE = ZoneInfo("Asia/Yekaterinburg")
DB_PATH = "bookings.db"
DAYS_AHEAD = 30
OPEN_HOUR = 8
MAX_PEOPLE = 24
CLOSE_HOUR = 20 # аудитория доступна до 20:00, последний слот 19:00–20:00
WEEKDAYS_RU = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"]
MONTHS_RU = [
"", "января", "февраля", "марта", "апреля", "мая", "июня",
"июля", "августа", "сентября", "октября", "ноября", "декабря",
]
def now_local() -> datetime:
return datetime.now(TIMEZONE)
def today_local() -> date:
return now_local().date()
def format_date_button(d: date) -> str:
return f"{d.day:02d}.{d.month:02d} ({WEEKDAYS_RU[d.weekday()]})"
def format_date_human(d: date) -> str:
return f"{d.day:02d}.{d.month:02d}.{d.year}"
def parse_iso_date(value: str) -> date:
return datetime.strptime(value, "%Y-%m-%d").date()
def slot_id(hour: int) -> str:
return f"{hour:02d}:00"
def slot_label(hour: int) -> str:
return f"{hour:02d}:00–{hour + 1:02d}:00"
def slot_hour(slot: str) -> int:
return int(slot.split(":")[0])
ACTIVE_STATUSES = ("pending", "approved")
# ======================================================================
# БАЗА ДАННЫХ (SQLite)
# ======================================================================
def _get_connection() -> sqlite3.Connection:
conn = sqlite3.connect(DB_PATH, timeout=10)
conn.row_factory = sqlite3.Row
conn.execute("PRAGMA journal_mode=WAL;")
conn.execute("PRAGMA foreign_keys=ON;")
return conn
def _init_db_sync() -> None:
conn = _get_connection()
try:
conn.execute(
"""
CREATE TABLE IF NOT EXISTS bookings (
id INTEGER PRIMARY KEY AUTOINCREMENT,
user_id INTEGER NOT NULL,
username TEXT,
name TEXT NOT NULL,
booking_date TEXT NOT NULL,
time_slot TEXT NOT NULL,
people INTEGER NOT NULL,
contact TEXT NOT NULL,
purpose TEXT NOT NULL,
status TEXT NOT NULL DEFAULT 'pending',
created_at TEXT NOT NULL
);
"""
)
# Партиционный уникальный индекс — защита от двойного бронирования.
# Одновременная вставка двух заявок на одно и то же дата+время
# со статусом pending/approved физически невозможна благодаря
# этому ограничению на уровне SQLite.
conn.execute(
"""
CREATE UNIQUE INDEX IF NOT EXISTS idx_active_slot
ON bookings(booking_date, time_slot)
WHERE status IN ('pending', 'approved');
"""
)
conn.commit()
finally:
conn.close()
def _get_occupied_slots_sync(booking_date: str) -> set:
conn = _get_connection()
try:
rows = conn.execute(
"""
SELECT time_slot FROM bookings
WHERE booking_date = ? AND status IN ('pending', 'approved');
""",
(booking_date,),
).fetchall()
return {row["time_slot"] for row in rows}
finally:
conn.close()
def _create_booking_sync(
user_id: int,
username: str | None,
name: str,
booking_date: str,
time_slot: str,
people: int,
contact: str,
purpose: str,
) -> int | None:
"""Возвращает id созданной заявки, либо None, если слот уже занят."""
conn = _get_connection()
try:
created_at = now_local().strftime("%Y-%m-%d %H:%M:%S")
cur = conn.execute(
"""
INSERT INTO bookings
(user_id, username, name, booking_date, time_slot,
people, contact, purpose, status, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'pending', ?);
""",
(
user_id,
username,
name,
booking_date,
time_slot,
people,
contact,
purpose,
created_at,
),
)
conn.commit()
return cur.lastrowid
except sqlite3.IntegrityError:
# Слот уже занят другой активной заявкой (pending/approved).
return None
finally:
conn.close()
def _get_booking_sync(booking_id: int) -> sqlite3.Row | None:
conn = _get_connection()
try:
return conn.execute(
).fetchone()
finally:
conn.close()
"SELECT * FROM bookings WHERE id = ?;", (booking_id,)
def _update_status_sync(booking_id: int, status: str) -> None:
conn = _get_connection()
try:
conn.execute(
"UPDATE bookings SET status = ? WHERE id = ?;", (status, booking_id)
)
conn.commit()
finally:
conn.close()
def _get_active_bookings_sync() -> list:
conn = _get_connection()
try:
rows = conn.execute(
"""
SELECT * FROM bookings
WHERE status IN ('pending', 'approved')
ORDER BY booking_date ASC, time_slot ASC;
"""
).fetchall()
return list(rows)
finally:
conn.close()
async def init_db() -> None:
await asyncio.to_thread(_init_db_sync)
async def get_occupied_slots(booking_date: str) -> set:
return await asyncio.to_thread(_get_occupied_slots_sync, booking_date)
async def create_booking(**kwargs) -> int | None:
return await asyncio.to_thread(_create_booking_sync, **kwargs)
async def get_booking(booking_id: int):
return await asyncio.to_thread(_get_booking_sync, booking_id)
async def update_status(booking_id: int, status: str) -> None:
await asyncio.to_thread(_update_status_sync, booking_id, status)
async def get_active_bookings() -> list:
return await asyncio.to_thread(_get_active_bookings_sync)
# ======================================================================
# FSM СОСТОЯНИЯ
# ======================================================================
class BookingStates(StatesGroup):
choosing_date = State()
choosing_time = State()
choosing_people = State()
entering_name = State()
entering_contact = State()
entering_purpose = State()
# ======================================================================
# CALLBACK DATA
# ======================================================================
class MenuCB(CallbackData, prefix="menu"):
action: str # "book" | "cancel"
class DateCB(CallbackData, prefix="dt"):
value: str # YYYY-MM-DD
class TimeCB(CallbackData, prefix="tm"):
date: str
slot: str
class PeopleCB(CallbackData, prefix="ppl"):
count: int
class AdminDecisionCB(CallbackData, prefix="adm"):
action: str # "approve" | "reject"
booking_id: int
class DeleteAllCB(CallbackData, prefix="delall"):
action: str # "confirm" | "cancel"
# ======================================================================
# КЛАВИАТУРЫ
# ======================================================================
def main_menu_keyboard():
kb = InlineKeyboardBuilder()
kb.button(text=" Забронировать аудиторию", callback_data=MenuCB(action="book"))
kb.button(text=" Отменить", callback_data=MenuCB(action="cancel"))
kb.adjust(1)
return kb.as_markup()
def dates_keyboard():
kb = InlineKeyboardBuilder()
start = today_local()
for i in range(DAYS_AHEAD):
d = start + timedelta(days=i)
kb.button(text=format_date_button(d), callback_data=DateCB(value=d.isoformat()))
kb.button(text=" Отменить", callback_data=MenuCB(action="cancel"))
kb.adjust(3)
return kb.as_markup()
def times_keyboard(booking_date: str, occupied: set):
kb = InlineKeyboardBuilder()
for hour in range(OPEN_HOUR, CLOSE_HOUR):
sid = slot_id(hour)
if sid in occupied:
continue
kb.button(
text=slot_label(hour),
callback_data=TimeCB(date=booking_date, slot=sid),
)
kb.adjust(3)
return kb.as_markup()
kb.button(text=" Отменить", callback_data=MenuCB(action="cancel"))
def people_keyboard():
kb = InlineKeyboardBuilder()
for n in range(1, MAX_PEOPLE + 1):
kb.button(text=str(n), callback_data=PeopleCB(count=n))
kb.button(text=" Отменить", callback_data=MenuCB(action="cancel"))
kb.adjust(6)
return kb.as_markup()
def admin_decision_keyboard(booking_id: int):
kb = InlineKeyboardBuilder()
kb.button(
text=" ПОДТВЕРДИТЬ",
callback_data=AdminDecisionCB(action="approve", booking_id=booking_id),
)
kb.button(
text=" ОТКЛОНИТЬ",
callback_data=AdminDecisionCB(action="reject", booking_id=booking_id),
)
kb.adjust(2)
return kb.as_markup()
def delete_confirm_keyboard():
kb = InlineKeyboardBuilder()
kb.button(text=" Да, отменить все", callback_data=DeleteAllCB(action="confirm"))
kb.button(text=" Нет", callback_data=DeleteAllCB(action="cancel"))
kb.adjust(1)
return kb.as_markup()
# ======================================================================
# РОУТЕР И ХЕНДЛЕРЫ
# ======================================================================
router = Router()
def is_admin(user_id: int) -> bool:
return user_id == ADMIN_USER_ID
async def send_main_menu(message: Message) -> None:
await message.answer(
" <b>ГАРАНИНЦЫ</b>\n\nДобро пожаловать!\n\nВыберите действие:",
reply_markup=main_menu_keyboard(),
)
@router.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext) -> None:
await state.clear()
await send_main_menu(message)
@router.message(Command("cancel"))
async def cmd_cancel(message: Message, state: FSMContext) -> None:
current_state = await state.get_state()
await state.clear()
if current_state is None:
await message.answer("Нечего отменять.")
else:
await message.answer(" Бронирование отменено.")
async def start_booking_flow(bot: Bot, chat_id: int, state: FSMContext) -> None:
await state.set_state(BookingStates.choosing_date)
await bot.send_message(
chat_id,
" Выберите дату:",
reply_markup=dates_keyboard(),
)
@router.message(Command("book"))
async def cmd_book(message: Message, state: FSMContext) -> None:
await state.clear()
await start_booking_flow(message.bot, message.chat.id, state)
@router.callback_query(MenuCB.filter(F.action == "book"))
async def cb_menu_book(call: CallbackQuery, state: FSMContext) -> None:
await state.clear()
await call.answer()
await start_booking_flow(call.bot, call.message.chat.id, state)
@router.callback_query(MenuCB.filter(F.action == "cancel"))
async def cb_menu_cancel(call: CallbackQuery, state: FSMContext) -> None:
await state.clear()
await call.answer()
try:
await call.message.edit_text(" Бронирование отменено.")
except TelegramBadRequest:
await call.message.answer(" Бронирование отменено.")
@router.callback_query(BookingStates.choosing_date, DateCB.filter())
async def cb_date_chosen(
call: CallbackQuery, callback_data: DateCB, state: FSMContext
) -> None:
await call.answer()
booking_date = callback_data.value
occupied = await get_occupied_slots(booking_date)
free_slots_exist = any(
slot_id(h) not in occupied for h in range(OPEN_HOUR, CLOSE_HOUR)
)
await state.update_data(booking_date=booking_date)
await state.set_state(BookingStates.choosing_time)
d = parse_iso_date(booking_date)
header = f" Выберите время на {format_date_human(d)}:"
if not free_slots_exist:
header = (
f"На {format_date_human(d)} свободных часов не осталось.\n"
"Пожалуйста, выберите другую дату или отмените бронирование."
)
try:
await call.message.edit_text(header, reply_markup=times_keyboard(booking_date, except TelegramBadRequest:
await call.message.answer(header, reply_markup=times_keyboard(booking_date, occupied)
occupi
@router.callback_query(BookingStates.choosing_time, TimeCB.filter())
async def cb_time_chosen(
call: CallbackQuery, callback_data: TimeCB, state: FSMContext
) -> None:
booking_date = callback_data.date
slot = callback_data.slot
# Повторно проверяем занятость на момент выбора — защита от гонки
# в интерфейсе (окончательная защита всё равно на уровне БД).
occupied = await get_occupied_slots(booking_date)
if slot in occupied:
await call.answer(" Это время уже занято.", show_alert=True)
try:
await call.message.edit_reply_markup(
reply_markup=times_keyboard(booking_date, occupied)
)
except TelegramBadRequest:
pass
return
await call.answer()
await state.update_data(time_slot=slot)
await state.set_state(BookingStates.choosing_people)
try:
await call.message.edit_text(
" Сколько людей будет присутствовать?",
reply_markup=people_keyboard(),
)
except TelegramBadRequest:
await call.message.answer(
" Сколько людей будет присутствовать?",
reply_markup=people_keyboard(),
)
@router.callback_query(BookingStates.choosing_people, PeopleCB.filter())
async def cb_people_chosen(
call: CallbackQuery, callback_data: PeopleCB, state: FSMContext
) -> None:
await call.answer()
await state.update_data(people=callback_data.count)
await state.set_state(BookingStates.entering_name)
try:
await call.message.edit_text("Введите ваше имя:")
except TelegramBadRequest:
await call.message.answer("Введите ваше имя:")
@router.message(BookingStates.entering_name, F.text)
async def process_name(message: Message, state: FSMContext) -> None:
name = message.text.strip()
if not name:
await message.answer("Пожалуйста, введите корректное имя:")
return
await state.update_data(name=name)
await state.set_state(BookingStates.entering_contact)
await message.answer("Введите номер телефона или другой контакт:")
@router.message(BookingStates.entering_contact, F.text)
async def process_contact(message: Message, state: FSMContext) -> None:
contact = message.text.strip()
if not contact:
await message.answer("Пожалуйста, введите корректный контакт:")
return
await state.update_data(contact=contact)
await state.set_state(BookingStates.entering_purpose)
await message.answer("Для чего бронируете аудиторию?")
@router.message(BookingStates.entering_purpose, F.text)
async def process_purpose(message: Message, state: FSMContext) -> None:
purpose = message.text.strip()
if not purpose:
await message.answer("Пожалуйста, укажите цель бронирования:")
return
data = await state.get_data()
booking_date = data["booking_date"]
time_slot = data["time_slot"]
people = data["people"]
name = data["name"]
contact = data["contact"]
user = message.from_user
booking_id = await create_booking(
user_id=user.id,
username=user.username,
name=name,
booking_date=booking_date,
time_slot=time_slot,
people=people,
contact=contact,
purpose=purpose,
)
if booking_id is None:
await state.set_state(BookingStates.choosing_time)
occupied = await get_occupied_slots(booking_date)
await message.answer(
" К сожалению, это время уже заняли.\n\n"
"Пожалуйста, выберите другое время:",
reply_markup=times_keyboard(booking_date, occupied),
)
return
await state.clear()
d = parse_iso_date(booking_date)
hour = slot_hour(time_slot)
time_range = slot_label(hour)
await message.answer(
" Заявка отправлена и ожидает подтверждения администратора.\n\n"
f" Дата: {format_date_human(d)}\n"
f" Время: {time_range}\n"
f" Людей: {people}"
)
username_display = f"@{user.username}" if user.username else "(нет username)"
admin_text = (
" НОВАЯ ЗАЯВКА\n\n"
f" Дата: {booking_date}\n"
f" Время: {time_range}\n"
f" Людей: {people}\n\n"
f" Имя: {name}\n"
f" Контакт: {contact}\n"
f" Цель: {purpose}\n\n"
f" Telegram: {username_display}"
)
try:
await message.bot.send_message(
ADMIN_USER_ID,
admin_text,
reply_markup=admin_decision_keyboard(booking_id),
)
except (TelegramForbiddenError, TelegramBadRequest) as exc:
logger.warning(
"Не удалось отправить заявку администратору (id=%s): %s",
booking_id,
exc,
)
@router.callback_query(AdminDecisionCB.filter())
async def cb_admin_decision(
call: CallbackQuery, callback_data: AdminDecisionCB
) -> None:
if not is_admin(call.from_user.id):
await call.answer(" У вас нет прав администратора.", show_alert=True)
return
booking = await get_booking(callback_data.booking_id)
if booking is None:
await call.answer("Заявка не найдена.", show_alert=True)
return
if booking["status"] != "pending":
await call.answer("Эта заявка уже обработана.", show_alert=True)
return
d = parse_iso_date(booking["booking_date"])
hour = slot_hour(booking["time_slot"])
time_range = slot_label(hour)
date_human = format_date_human(d)
if callback_data.action == "approve":
await update_status(booking["id"], "approved")
await call.answer("Заявка подтверждена.")
try:
await call.bot.send_message(
booking["user_id"],
" РЕПЕТИЦИЯ ПОДТВЕРЖДЕНА!\n\n"
f" Дата: {date_human}\n"
f" Время: {time_range}\n"
f" Людей: {booking['people']}",
)
except (TelegramForbiddenError, TelegramBadRequest) as exc:
logger.warning("Не удалось уведомить пользователя об одобрении: %s", exc)
if ANNOUNCEMENT_CHAT_ID is not None:
try:
await call.bot.send_message(
ANNOUNCEMENT_CHAT_ID,
" РЕПЕТИЦИЯ СОСТОИТСЯ\n\n"
f" Дата: {date_human}\n"
f" Время: {time_range}\n"
f" Количество: {booking['people']} человек\n"
f" Цель: {booking['purpose']}",
)
except (TelegramForbiddenError, TelegramBadRequest) as exc:
logger.warning(
"Не удалось опубликовать анонс в ANNOUNCEMENT_CHAT_ID: %s", exc
)
try:
await call.message.edit_text(
call.message.text + "\n\n ПОДТВЕРЖДЕНО"
)
except TelegramBadRequest:
pass
else: # reject
await update_status(booking["id"], "rejected")
await call.answer("Заявка отклонена.")
try:
await call.bot.send_message(
booking["user_id"],
" Бронирование отклонено.\n\n"
f" Дата: {date_human}\n"
f" Время: {time_range}",
)
except (TelegramForbiddenError, TelegramBadRequest) as exc:
logger.warning("Не удалось уведомить пользователя об отклонении: %s", exc)
try:
await call.message.edit_text(
call.message.text + "\n\n ОТКЛОНЕНО"
)
except TelegramBadRequest:
pass
@router.message(Command("rv"))
async def cmd_rv(message: Message) -> None:
if not is_admin(message.from_user.id):
await message.answer(" return
У вас нет прав администратора.")
bookings = await get_active_bookings()
if not bookings:
await message.answer(" Активных бронирований нет.")
return
blocks = []
for b in bookings:
d = parse_iso_date(b["booking_date"])
hour = slot_hour(b["time_slot"])
status_label = "ожидает" if b["status"] == "pending" else "подтверждено"
blocks.append(
f" {format_date_human(d)}\n"
f" {slot_label(hour)}\n"
f" {b['name']}\n"
f" {b['people']} человек\n"
f" {b['purpose']}\n"
f"Статус: {status_label}"
)
text = " ТЕКУЩИЕ РЕПЕТИЦИИ\n\n" + "\n\n".join(blocks)
# Telegram ограничивает длину сообщения — разбиваем при необходимости.
for chunk_start in range(0, len(text), 4000):
await message.answer(text[chunk_start:chunk_start + 4000])
@router.message(Command("delete"))
async def cmd_delete(message: Message) -> None:
if not is_admin(message.from_user.id):
await message.answer(" У вас нет прав администратора.")
return
bookings = await get_active_bookings()
if not bookings:
await message.answer(" Активных бронирований нет.")
return
await message.answer(
f" Вы собираетесь отменить все активные бронирования ({len(bookings)} шт.).\n"
"Подтвердите действие:",
reply_markup=delete_confirm_keyboard(),
)
@router.callback_query(DeleteAllCB.filter())
async def cb_delete_all(call: CallbackQuery, callback_data: DeleteAllCB) -> None:
if not is_admin(call.from_user.id):
await call.answer(" У вас нет прав администратора.", show_alert=True)
return
if callback_data.action == "cancel":
await call.answer("Отменено.")
try:
await call.message.edit_text("Действие отменено.")
except TelegramBadRequest:
pass
return
await call.answer()
bookings = await get_active_bookings()
for b in bookings:
await update_status(b["id"], "rejected")
try:
await call.bot.send_message(
b["user_id"],
" Внимание!\n\nВаше бронирование было отменено администратором.",
)
except (TelegramForbiddenError, TelegramBadRequest) as exc:
logger.warning(
"Не удалось уведомить пользователя %s об отмене: %s", b["user_id"], exc
)
try:
await call.message.edit_text(f" Отменено бронирований: {len(bookings)}.")
except TelegramBadRequest:
await call.message.answer(f" Отменено бронирований: {len(bookings)}.")
# Фолбэк на случай, если пользователь пишет текст вне ожидаемого состояния.
@router.message()
async def fallback_handler(message: Message, state: FSMContext) -> None:
current_state = await state.get_state()
if current_state is not None:
await message.answer(
"Пожалуйста, воспользуйтесь кнопками выше, либо отправьте /cancel, "
"чтобы прервать текущее бронирование."
)
return
await send_main_menu(message)
# ======================================================================
# ТОЧКА ВХОДА
# ======================================================================
async def main() -> None:
await init_db()
bot = Bot(
token=BOT_TOKEN,
default=DefaultBotProperties(parse_mode=ParseMode.HTML),
)
dp = Dispatcher(storage=MemoryStorage())
dp.include_router(router)
logger.info("Бот «Гаранинцы» запускается...")
await bot.delete_webhook(drop_pending_updates=True)
await dp.start_polling(bot)
if __name__ == "__main__":
asyncio.run(main() )
