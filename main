# ============================================================

@router.message(
    Command("rv")
)
async def rv_command(
    message: Message,
):
    if not is_admin(
        message.from_user.id
    ):
        await message.answer(
            "Нет прав администратора."
        )

        return

    bookings = get_active_bookings()

    if not bookings:
        await message.answer(
            "Активных бронирований нет."
        )

        return

    await message.answer(
        f"АКТИВНЫЕ БРОНИРОВАНИЯ: {len(bookings)}"
    )

    for booking in bookings:
        status = (
            "ОЖИДАЕТ"
            if booking["status"] == "pending"
            else "ПОДТВЕРЖДЕНО"
        )

        text = (
            f"Заявка №{booking['id']}\n\n"
            f"Дата: {format_date_ru(booking['date'])}\n"
            f"Время: "
            f"{booking['time_start']}–"
            f"{booking['time_end']}\n"
            f"Людей: {booking['people_count']}\n"
            f"Имя: {booking['name']}\n"
            f"Контакт: {booking['contact']}\n"
            f"Цель: {booking['purpose']}\n\n"
            f"Статус: {status}"
        )

        await message.answer(text)


# ============================================================
# /DELETE
# ============================================================

@router.message(
    Command("delete")
)
async def delete_command(
    message: Message,
    state: FSMContext,
):
    if not is_admin(
        message.from_user.id
    ):
        await message.answer(
            "Нет прав администратора."
        )

        return

    bookings = get_active_bookings()

    if not bookings:
        await message.answer(
            "Активных бронирований нет."
        )

        return

    await state.set_state(
        DeleteStates.confirming
    )

    await message.answer(
        "ВНИМАНИЕ!\n\n"
        f"Будет отменено: {len(bookings)} бронирований.\n\n"
        "Продолжить?",
        reply_markup=delete_confirm_keyboard(),
    )


# ============================================================
# DELETE CONFIRM
# ============================================================

@router.callback_query(
    DeleteStates.confirming,
    F.data == "delete_confirm",
)
async def delete_confirm(
    callback: CallbackQuery,
    state: FSMContext,
):
    if not is_admin(
        callback.from_user.id
    ):
        await callback.answer(
            "Нет прав.",
            show_alert=True,
        )

        return

    await callback.answer()

    await state.clear()

    bookings = clear_all_active_bookings()

    for booking in bookings:
        try:
            await callback.bot.send_message(
                chat_id=booking["user_id"],
                text=(
                    "Ваше бронирование "
                    "было отменено "
                    "администратором."
                ),
            )

        except (
            TelegramBadRequest,
            TelegramForbiddenError,
        ):
            pass

    try:
        await callback.message.edit_text(
            f"Удалено бронирований: {len(bookings)}"
        )

    except TelegramBadRequest:
        pass


# ============================================================
# DELETE CANCEL
# ============================================================

@router.callback_query(
    DeleteStates.confirming,
    F.data == "delete_cancel",
)
async def delete_cancel(
    callback: CallbackQuery,
    state: FSMContext,
):
    await callback.answer()

    await state.clear()

    try:
        await callback.message.edit_text(
            "Удаление отменено."
        )

    except TelegramBadRequest:
        pass


