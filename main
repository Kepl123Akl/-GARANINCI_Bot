# ============================================================
# ROUTER
# ============================================================

router = Router()


# ============================================================
# /START
# ============================================================

@router.message(
    CommandStart()
)
async def cmd_start(
    message: Message,
    state: FSMContext,
) -> None:

    await state.clear()

    await message.answer(
        "🎭 ГАРАНИНЦЫ\n\n"
        "Добро пожаловать!\n\n"
        "Выберите действие:",
        reply_markup=(
            main_menu_keyboard()
        ),
    )


# ============================================================
# /REZA
#
# Пример:
#
# /reza Завтра репетиция в 18:00
#
# Бот отправит:
#
# Завтра репетиция в 18:00
#
# именно в тот чат, где написана команда.
# ============================================================

@router.message(
    Command("reza")
)
async def cmd_reza(
    message: Message,
) -> None:

    # Проверяем администратора
    if not is_admin(
        message.from_user.id
    ):

        await message.answer(
            "❌ У вас нет прав "
            "администратора."
        )

        return

    text = message.text or ""

    parts = text.split(
        maxsplit=1
    )

    # Если текст не указан
    if (
        len(parts) < 2
        or not parts[1].strip()
    ):

        await message.answer(
            "Использование:\n\n"
            "/reza Текст сообщения\n\n"
            "Например:\n"
            "/reza Завтра репетиция "
            "в 18:00."
        )

        return

    reza_text = parts[1].strip()

    try:

        # Отправляем сообщение
        # в ТОТ ЖЕ чат
        await message.bot.send_message(
            chat_id=message.chat.id,
            text=reza_text,
        )

        # Пытаемся удалить команду
        try:

            await message.delete()

        except TelegramBadRequest:

            pass

    except TelegramForbiddenError:

        await message.answer(
            "❌ У бота нет права "
            "отправлять сообщения "
            "в этом чате."
        )

    except TelegramBadRequest as exc:

        logger.error(
            "Ошибка /reza: %s",
            exc,
        )

        await message.answer(
            "❌ Не удалось отправить "
            "сообщение."
        )


# ============================================================
# /BOOK
# ============================================================

@router.message(
    Command("book")
)
async def cmd_book(
    message: Message,
    state: FSMContext,
) -> None:

    await state.clear()

    await state.set_state(
        BookingStates.choosing_date
    )

    await message.answer(
        "Выберите дату бронирования:",
        reply_markup=(
            date_keyboard()
        ),
    )


# ============================================================
# КНОПКА BOOK
# ============================================================

@router.callback_query(
    F.data == "book_start"
)
async def cb_book_start(
    callback: CallbackQuery,
    state: FSMContext,
) -> None:

    await callback.answer()

    await state.clear()

    await state.set_state(
        BookingStates.choosing_date
    )

    await callback.message.answer(
        "Выберите дату бронирования:",
        reply_markup=(
            date_keyboard()
        ),
    )


# ============================================================
# /CANCEL
# ============================================================

@router.message(
    Command("cancel")
)
async def cmd_cancel(
    message: Message,
    state: FSMContext,
) -> None:

    await state.clear()

    await message.answer(
        "❌ Действие отменено."
    )


# ============================================================
# ВЫБОР ДАТЫ
# ============================================================

@router.callback_query(
    BookingStates.choosing_date,
    F.data.startswith("date:"),
)
async def cb_choose_date(
    callback: CallbackQuery,
    state: FSMContext,
) -> None:

    await callback.answer()

    date_str = callback.data.split(
        ":",
        1,
    )[1]

    kb = time_keyboard(
        date_str
    )

    if kb is None:

        await callback.message.answer(
            "😔 На эту дату "
            "свободного времени "
            "не осталось.\n\n"
            "Выберите другую дату:",
            reply_markup=(
                date_keyboard()
            ),
        )

        return

    await state.update_data(
        date=date_str
    )

    await state.set_state(
        BookingStates.choosing_time
    )

    await callback.message.answer(
        f"Дата: "
        f"{format_date_ru(date_str)}\n\n"
        "Выберите свободное время:",
        reply_markup=kb,
    )


# ============================================================
# ВЫБОР ВРЕМЕНИ
# ============================================================

@router.callback_query(
    BookingStates.choosing_time,
    F.data.startswith("time:"),
)
async def cb_choose_time(
    callback: CallbackQuery,
    state: FSMContext,
) -> None:

    data = await state.get_data()

    date_str = data.get(
        "date"
    )

    if not date_str:

        await callback.answer(
            "Сессия устарела.",
            show_alert=True,
        )

        await state.clear()

        return

    hour = int(
        callback.data.split(
            ":",
            1,
        )[1]
    )

    busy_hours = get_busy_hours(
        date_str
    )

    if hour in busy_hours:

        await callback.answer(
            "❌ Это время уже занято.",
            show_alert=True,
        )

        return

    await callback.answer()

    start, end = slot_bounds(
        hour
    )

    await state.update_data(
        time_start=start,
        time_end=end,
    )

    await state.set_state(
        BookingStates.choosing_people
    )

    await callback.message.answer(
        f"Время: {start}–{end}\n\n"
        "Выберите количество людей:",
        reply_markup=(
            people_keyboard()
        ),
    )


# ============================================================
# ВЫБОР ЛЮДЕЙ
# ============================================================

@router.callback_query(
    BookingStates.choosing_people,
    F.data.startswith("people:"),
)
async def cb_choose_people(
    callback: CallbackQuery,
    state: FSMContext,
) -> None:

    await callback.answer()

    people = int(
        callback.data.split(
            ":",
            1,
        )[1]
    )

    if not (
        1 <= people <= MAX_PEOPLE
    ):

        await callback.answer(
            "Недопустимое количество.",
            show_alert=True,
        )

        return

    await state.update_data(
        people_count=people
    )

    await state.set_state(
        BookingStates.entering_name
    )

    await callback.message.answer(
        "Введите ваше имя:"
    )


# ============================================================
# ВВОД ИМЕНИ
# ============================================================

@router.message(
    BookingStates.entering_name,
    F.text,
)
async def process_name(
    message: Message,
    state: FSMContext,
) -> None:

    name = message.text.strip()

    if not name:

        await message.answer(
            "Имя не может быть пустым."
        )

        return

    await state.update_data(
        name=name
    )

    await state.set_state(
        BookingStates.entering_contact
    )

    await message.answer(
        "Введите номер телефона "
        "или другой контакт:"
    )


# ============================================================
# ВВОД КОНТАКТА
# ============================================================

@router.message(
    BookingStates.entering_contact,
    F.text,
)
async def process_contact(
    message: Message,
    state: FSMContext,
) -> None:

    contact = message.text.strip()

    if not contact:

        await message.answer(
            "Контакт не может быть пустым."
        )

        return

    await state.update_data(
        contact=contact
    )

    await state.set_state(
        BookingStates.entering_purpose
    )

    await message.answer(
        "Для чего бронируете аудиторию?"
    )


# ============================================================
# ВВОД ЦЕЛИ И СОЗДАНИЕ ЗАЯВКИ
# ============================================================

@router.message(
    BookingStates.entering_purpose,
    F.text,
)
async def process_purpose(
    message: Message,
    state: FSMContext,
    bot: Bot,
) -> None:

    purpose = message.text.strip()

    if not purpose:

        await message.answer(
            "Опишите цель бронирования."
        )

        return

    data = await state.get_data()

    date_str = data["date"]

    time_start = data["time_start"]

    time_end = data["time_end"]

    people_count = data["people_count"]

    name = data["name"]

    contact = data["contact"]

    booking_id: Optional[int] = None

    async with db_lock:

        busy_hours = get_busy_hours(
            date_str
        )

        hour = int(
            time_start.split(":")[0]
        )

        if hour not in busy_hours:

            try:

                booking_id = create_booking(
                    user_id=(
                        message.from_user.id
                    ),
                    username=(
                        message.from_user.username
                    ),
                    name=name,
                    date_str=date_str,
                    time_start=time_start,
                    time_end=time_end,
                    people_count=people_count,
                    contact=contact,
                    purpose=purpose,
                )

            except sqlite3.IntegrityError:

                booking_id = None

    # Если кто-то занял время раньше
    if booking_id is None:

        await state.set_state(
            BookingStates.choosing_time
        )

        kb = time_keyboard(
            date_str
        )

        if kb is None:

            await state.set_state(
                BookingStates.choosing_date
            )

            await message.answer(
                "❌ Это время уже заняли.\n\n"
                "На эту дату свободного "
                "времени больше нет.",
                reply_markup=(
                    date_keyboard()
                ),
            )

        else:

            await message.answer(
                "❌ К сожалению, "
                "это время уже заняли.\n\n"
                "Выберите другое время:",
                reply_markup=kb,
            )

        return

    # Очищаем состояние
    await state.clear()

    # Сообщение пользователю
    await message.answer(
        "✅ Заявка отправлена!\n\n"
        "Она ожидает подтверждения "
        "администратора.\n\n"
        f"📅 Дата: "
        f"{format_date_ru(date_str)}\n"
        f"⏰ Время: "
        f"{time_start}–{time_end}\n"
        f"👥 Людей: "
        f"{people_count}"
    )

    username_display = (
        f"@{message.from_user.username}"
        if message.from_user.username
        else "—"
    )

    # Заявка администратору
    admin_text = (
        "🎭 НОВАЯ ЗАЯВКА\n\n"

        f"📅 Дата: "
        f"{format_date_ru(date_str)}\n"

        f"⏰ Время: "
        f"{time_start}–{time_end}\n"

        f"👥 Людей: "
        f"{people_count}\n\n"

        f"👤 Имя: {name}\n"

        f"📞 Контакт: {contact}\n"

        f"🎯 Цель: {purpose}\n\n"

        f"💬 Telegram: "
        f"{username_display}\n"

        f"🆔 Заявка №{booking_id}"
    )

    try:

        await bot.send_message(
            chat_id=ADMIN_USER_ID,
            text=admin_text,
            reply_markup=(
                admin_decision_keyboard(
                    booking_id
                )
            ),
        )

    except (
        TelegramBadRequest,
        TelegramForbiddenError,
    ) as exc:

        logger.error(
            "Не удалось отправить "
            "заявку администратору: %s",
            exc,
        )


# ============================================================
# ПОДТВЕРЖДЕНИЕ
# ============================================================

@router.callback_query(
    F.data.startswith("approve:")
)
async def cb_approve(
    callback: CallbackQuery,
    bot: Bot,
) -> None:

    if not is_admin(
        callback.from_user.id
    ):

        await callback.answer(
            "❌ Нет прав администратора.",
            show_alert=True,
        )

        return

    booking_id = int(
        callback.data.split(
            ":",
            1,
        )[1]
    )

    booking = get_booking(
        booking_id
    )

    if booking is None:

        await callback.answer(
            "Заявка не найдена.",
            show_alert=True,
        )

        return

    if booking["status"] != "pending":

        await callback.answer(
            "Эта заявка уже обработана.",
            show_alert=True,
        )

        return

    set_booking_status(
        booking_id,
        "approved",
    )

    await callback.answer(
        "Заявка подтверждена."
    )

    # Меняем сообщение администратора
    try:

        await callback.message.edit_text(
            callback.message.text
            + "\n\n"
            + "✅ ПОДТВЕРЖДЕНО"
        )

    except TelegramBadRequest:

        pass

    # Уведомление пользователя
    date_ru = format_date_ru(
        booking["date"]
    )

    user_text = (
        "✅ РЕПЕТИЦИЯ "
        "ПОДТВЕРЖДЕНА!\n\n"

        f"📅 Дата: {date_ru}\n"

        f"⏰ Время: "
        f"{booking['time_start']}"
        f"–"
        f"{booking['time_end']}\n"

        f"👥 Людей: "
        f"{booking['people_count']}"
    )

    try:

        await bot.send_message(
            chat_id=booking["user_id"],
            text=user_text,
        )

    except (
        TelegramBadRequest,
        TelegramForbiddenError,
    ) as exc:

        logger.error(
            "Не удалось уведомить "
            "пользователя: %s",
            exc,
        )


