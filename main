@router.callback_query(
    F.data.startswith("reject:")
)
async def reject_booking(
    callback: CallbackQuery,
):

    if not is_admin(
        callback.from_user.id
    ):

        await callback.answer(
            "Нет прав.",
            show_alert=True,
        )

        return

    booking_id = int(
        callback.data.split(
            ":",
            1,
        )[1]
    )

    booking = get_booking(
        booking_id
    )

    if booking is None:

        await callback.answer(
            "Заявка не найдена.",
            show_alert=True,
        )

        return

    if booking["status"] != "pending":

        await callback.answer(
            "Заявка уже обработана.",
            show_alert=True,
        )

        return

    set_booking_status(
        booking_id,
        "rejected",
    )

    await callback.answer(
        "Отклонено."
    )

    try:

        await callback.message.edit_text(
            callback.message.text
            + "\n\n"
            + "ОТКЛОНЕНО"
        )

    except TelegramBadRequest:
        pass

    try:

        await callback.bot.send_message(
            chat_id=booking["user_id"],
            text=(
                "Бронирование отклонено.\n\n"
                f"Дата: "
                f"{format_date_ru(booking['date'])}\n"
                f"Время: "
                f"{booking['time_start']}"
                f"–"
                f"{booking['time_end']}"
            ),
        )

    except (
        TelegramBadRequest,
        TelegramForbiddenError,
    ):

        pass


# ============================================================
# /RV
# ============================================================

@router.message(
    Command("rv")
)
async def rv_command(
    message: Message,
):

    if not is_admin(
        message.from_user.id
    ):

        await message.answer(
            "Нет прав администратора."
        )

        return

    bookings = get_active_bookings()

    if not bookings:

        await message.answer(
            "Активных бронирований нет."
        )

        return

    await message.answer(
        f"АКТИВНЫЕ БРОНИРОВАНИЯ: "
        f"{len(bookings)}"
    )

    for booking in bookings:

        status = (
            "ОЖИДАЕТ"
            if booking["status"] == "pending"
            else
            "ПОДТВЕРЖДЕНО"
        )

        text = (
            f"Заявка №{booking['id']}\n\n"
            f"Дата: "
            f"{format_date_ru(booking['date'])}\n"
            f"Время: "
            f"{booking['time_start']}"
            f"–"
            f"{booking['time_end']}\n"
            f"Людей: "
            f"{booking['people_count']}\n"
            f"Имя: "
            f"{booking['name']}\n"
            f"Контакт: "
            f"{booking['contact']}\n"
            f"Цель: "
            f"{booking['purpose']}\n\n"
            f"Статус: {status}"
        )

        await message.answer(
            text
        )


# ============================================================
# /DELETE
# ============================================================

@router.message(
    Command("delete")
)
async def delete_command(
    message: Message,
    state: FSMContext,
):

    if not is_admin(
        message.from_user.id
    ):

        await message.answer(
            "Нет прав администратора."
        )

        return

    bookings = get_active_bookings()

    if not bookings:

        await message.answer(
            "Активных бронирований нет."
        )

        return

    await state.set_state(
        DeleteStates.confirming
    )

    await message.answer(
        "ВНИМАНИЕ!\n\n"
        f"Будет отменено: "
        f"{len(bookings)} бронирований.\n\n"
        "Продолжить?",
        reply_markup=(
            delete_confirm_keyboard()
        ),
    )


# ============================================================
# DELETE CONFIRM
# ============================================================

@router.callback_query(
    DeleteStates.confirming,
    F.data == "delete_confirm",
)
async def delete_confirm(
    callback: CallbackQuery,
    state: FSMContext,
):

    if not is_admin(
        callback.from_user.id
    ):

        await callback.answer(
            "Нет прав.",
            show_alert=True,
        )

        return

    await callback.answer()

    await state.clear()

    bookings = clear_all_active_bookings()

    # Уведомляем пользователей
    for booking in bookings:

        try:

            await callback.bot.send_message(
                chat_id=booking["user_id"],
                text=(
                    "Ваше бронирование "
                    "было отменено "
                    "администратором."
                ),
            )

        except (
            TelegramBadRequest,
            TelegramForbiddenError,
        ):

            pass

    try:

        await callback.message.edit_text(
            f"Удалено бронирований: "
            f"{len(bookings)}"
        )

    except TelegramBadRequest:
        pass


# ============================================================
# DELETE CANCEL
# ============================================================

@router.callback_query(
    DeleteStates.confirming,
    F.data == "delete_cancel",
)
async def delete_cancel(
    callback: CallbackQuery,
    state: FSMContext,
):

    await callback.answer()

    await state.clear()

    try:

        await callback.message.edit_text(
            "Удаление отменено."
        )

    except TelegramBadRequest:
        pass


# ============================================================
# ЗАПУСК
# ============================================================

async def main():

    init_db()

    bot = Bot(
        token=BOT_TOKEN
    )

    dp = Dispatcher(
        storage=MemoryStorage()
    )

    dp.include_router(
        router
    )

    logger.info(
        "GARANINCI BOT STARTING"
    )

    logger.info(
        "Admin ID: %s",
        ADMIN_USER_ID,
    )

    logger.info(
        "Announcement system enabled"
    )

    # Для polling
    await bot.delete_webhook(
        drop_pending_updates=True
    )

    await dp.start_polling(
        bot
    )


if __name__ == "__main__":
    asyncio.run(
        main()
    )
